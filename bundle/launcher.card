# ledger finance-brief-launcher@0.3.0
# level:   L0
# model:   launcher
#
# Static glance tile for OctoSense shell.
# The interactive UI lives in bundle/main.splash (Path 1 card-host).
# Fullscreen app launch in shell requires OctoScript#56.

state selected { shape: text, initial: "" }    # reserved, no source

copy eyebrow  { class: vocabulary, en: "FINANCE BRIEF",  zh: "财经简报" }
copy title    { class: vocabulary, en: "Launcher",   zh: "主界面" }
copy hint     { class: vocabulary, en: "Launch card-host to view",  zh: "启动 card-host 查看" }

view root Surface(pad: .page) {
  Col(gap: 4) {
    TextCaption(text: copy.eyebrow)
    TextTitle(text: copy.title)
    TextBody(text: copy.hint)
  }
}
