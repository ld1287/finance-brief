// finance-brief 设置 — #9 of 12 screens (L0)
// Level:  L0 (declarative only, no derived arithmetic)
// Role:   theme picker + stream-frequency chip + 5 data-source toggles +
//         push-window hint + about + disclaimer link + back
// Spec:   docs/R-4-l0-cards.md §3 row 9, MVP-TODO.md §5 screen #9
// Change: Q-D: B — added stream-frequency chip (1s / 5s / 10s),
//         wired to the new capability `stream.frequency.set`.
//         Persistence: stream_frequency_set_workflow() routes the
//         `state.stream_frequency` patch into the app jail.
//
// Layout (top → bottom):
//   1. header bar:  back / title / subtitle
//   2. theme section:   label + 3 chips (light / dark / auto)
//   3. frequency section (per Q-D: B):
//                      label + hint + 3 chips (1s / 5s / 10s)
//   4. data-source section:  label + 5 toggle rows
//   5. push-window section:  label + hint copy
//   6. about section:        version + disclaimer link
//
// Capability contracts (per capabilities.toml §1 / §2):
//   settings.load         — host-side, no UI invocation
//   settings.save         — patch {theme} / {data_sources_enabled}
//   stream.frequency.set  — {frequency: "1s" | "5s" | "10s"} (Q-B / Q-D: B)
//
// L0 constraints honored:
//   - no `let q = "{{state.q}}"` style trip_planner L2 binding
//   - no widget-binding assignment operator (makepad_ui_counter non-canonical)
//   - all text values are `{{state.x}}` placeholders, host resolves at realize
//   - chip active state uses a single == predicate, no derived arithmetic
//
// State contract (host provides):
//   state.app_subtitle           : text   — header subtitle copy
//   state.settings.themes        : list   — 3 entries {id, label}
//   state.settings.theme_active  : text   — id of currently active theme
//   state.settings.frequencies   : list   — 3 entries {id, label}
//                                            ("1s" / "5s" / "10s")
//   state.settings.frequency_active : text — id of currently active freq
//   state.settings.frequency_hint : text  — explanation copy
//   state.settings.data_sources  : list   — 5 entries {id, name, enabled}
//   state.settings.push_window   : text   — push-time window copy

View {
    width: Fill
    height: Fill
    flow: Down
    padding: 16
    gap: 1

    // ── header ──────────────────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "< 主界面"
            on_tap: || nav.pop()
        }

        Label {
            text: "设置"
        }

        Label {
            text: "{{state.app_subtitle}}"
        }
    }

    // ── 段 1：主题切换（3 chip：light / dark / auto） ──────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "主题"
        }

        View {
            width: Fill
            height: Fit
            flow: Right

            for th in "{{state.settings.themes}}" {
                Label {
                    text: th.label
                    active: "{{state.settings.theme_active}}" == th.id
                    on_tap: || host.call("settings.save", {patch: {theme: th.id}})
                }
            }
        }
    }

    // ── 段 2：事件流刷新频率（per Q-D: B，1s / 5s / 10s） ─────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "事件流刷新频率"
        }

        Label {
            text: "{{state.settings.frequency_hint}}"
        }

        View {
            width: Fill
            height: Fit
            flow: Right

            for f in "{{state.settings.frequencies}}" {
                Label {
                    text: f.label
                    active: "{{state.settings.frequency_active}}" == f.id
                    on_tap: || host.call("stream.frequency.set", {frequency: f.id})
                }
            }
        }
    }

    // ── 段 3：5 数据源开关 ──────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "数据源"
        }

        for src in "{{state.settings.data_sources}}" {
            View {
                width: Fill
                height: Fit
                flow: Right

                Label {
                    text: src.name
                }

                Label {
                    text: src.enabled ? "ON" : "OFF"
                    on_tap: || host.call("settings.save", {patch: {data_sources_enabled: {toggle: src.id, enabled: !src.enabled}}})
                }
            }
        }
    }

    // ── 段 4：推送时段 ──────────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "推送时段"
        }

        Label {
            text: "{{state.settings.push_window}}"
        }
    }

    // ── 段 5：关于 + 免责声明入口 ──────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "finance-brief v0.3.0"
        }

        Label {
            text: "恢复默认设置"
            on_tap: || host.call("settings.save", {patch: {reset: true}})
        }

        Label {
            text: "免责声明 →"
            on_tap: || nav.push("disclaimer")
        }
    }
}