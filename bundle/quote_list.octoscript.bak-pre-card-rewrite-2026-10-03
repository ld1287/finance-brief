// finance-brief 行情列表合并 — #7 of 12 screens (L0)
// Level:  L0 (declarative only, no derived arithmetic)
// Role:   5-market tab switcher + 4 theme chip filter + unified list
// Spec:   docs/R-4-l0-cards.md §3 row 7, MVP-TODO.md §5 screen #7
//
// Layout (top → bottom):
//   1. header bar:  title / back / refresh
//   2. 5 market tabs:  A股 / 美股 / 港股 / 加密 / 外汇
//   3. 4 theme chips:  hot / 涨 / 跌 / 稳
//   4. status line (e.g. last-synced, error copy)
//   5. quote row list, each row → kline with symbol
//
// Capability contracts (per capabilities.toml / §2 quote cluster):
//   quote.snapshot   — reload quotes for current tab + optional theme filter
//                      host resolves data source per tab:
//                        tab=a/hk     → quote_tencent
//                        tab=us       → quote_stooq
//                        tab=crypto   → quote_hyperliquid
//                        tab=fx       → quote_frankfurter
//
// L0 constraints honored (per Phase 1 O-5 / O-4):
//   - no `let q = "{{state.q}}"` style trip_planner L2 binding
//   - no widget-binding assignment operator
//   - all text values are `{{state.x}}` placeholders, host resolves at realize
//   - chip / tab active state uses a single == predicate (no arithmetic)
//   - declarative View / Label structure only, no inline expressions
//
// State contract (host provides):
//   state.quote.tabs         : list  — 5 entries, each {id, label}
//   state.quote.tab_active   : text  — id of currently active tab
//   state.quote.themes       : list  — 4 entries, each {id, label}
//   state.quote.theme_active : text  — id of currently active theme chip
//   state.quote.status       : text  — status line (synced / loading / err)
//   state.quote.rows         : list  — quote entries, each {symbol, last, change_pct, volume}

View {
    width: Fill
    height: Fill
    flow: Down
    padding: 16
    gap: 1

    // ── header ──────────────────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "行情"
        }

        Label {
            text: "{{state.app_subtitle}}"
        }

        Label {
            text: "< 返回"
            on_tap: || nav.pop()
        }

        Label {
            text: "刷新"
            on_tap: || host.call("quote.snapshot", {tab: "{{state.quote.tab_active}}"})
        }
    }

    // ── 5 市场 tab：A股 / 美股 / 港股 / 加密 / 外汇 ──────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        for t in "{{state.quote.tabs}}" {
            Label {
                text: t.label
                active: "{{state.quote.tab_active}}" == t.id
                on_tap: || host.call("quote.snapshot", {tab: t.id})
            }
        }
    }

    // ── 4 主题 chip：hot / 涨 / 跌 / 稳 ──────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        for th in "{{state.quote.themes}}" {
            Label {
                text: th.label
                active: "{{state.quote.theme_active}}" == th.id
                on_tap: || host.call("quote.snapshot", {tab: "{{state.quote.tab_active}}", filter: th.id})
            }
        }
    }

    // ── 状态指示 ────────────────────────────────────────────────────────────
    Label {
        text: "{{state.quote.status}}"
    }

    // ── 行情列表 ────────────────────────────────────────────────────────────
    for q in "{{state.quote.rows}}" {
        View {
            width: Fill
            height: Fit
            flow: Right

            Label {
                text: q.symbol
            }

            Label {
                text: q.last
            }

            Label {
                text: q.change_pct
            }

            Label {
                text: q.volume
            }

            on_tap: || nav.push("kline", {symbol: q.symbol})
        }
    }

    // ── footer ──────────────────────────────────────────────────────────────
    Label {
        text: "{{state.last_synced}}"
    }
}