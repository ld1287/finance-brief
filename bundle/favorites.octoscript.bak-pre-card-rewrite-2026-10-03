// finance-brief 收藏 — #8 of 12 screens (L0)
// Level:  L0 (declarative only, no derived arithmetic)
// Role:   view filter chips + favorites list + remove + empty state + back
// Spec:   docs/R-4-l0-cards.md §3 row 8, MVP-TODO.md §5 screen #8
//
// Layout (top → bottom):
//   1. header bar:  back / title / count
//   2. 4 view chips:  全部 / 行情 / 新闻 / 研究
//   3. empty state (visible when state.fav.empty != "")
//   4. favorites list, each row → entity detail + ✕ remove button
//
// Capability contracts (per capabilities.toml §1 / §2):
//   fav.list     — reload favorites with optional kind filter via {kind: c.id}
//   fav.toggle   — add/remove by key, called with {key, add} (host routes to jail)
//
// L0 constraints honored:
//   - no `let q = "{{state.q}}"` style trip_planner L2 binding
//   - no widget-binding operator (canonical fixtures use plain nested widgets)
//   - all text values are `{{state.x}}` placeholders, host resolves at realize
//   - chip active state uses a single == predicate, no derived arithmetic
//   - empty state copy is host-bundled text, host decides visibility via empty flag
//
// State contract (host provides):
//   state.app_subtitle         : text  — header subtitle copy
//   state.fav_filters          : list  — 4 entries, each {id, label}
//   state.fav_filter_active    : text  — id of currently active chip
//   state.fav_count            : text  — number copy (e.g. "12 项")
//   state.fav_empty            : text  — empty flag copy, "" hides empty view
//   state.fav_empty_msg        : text  — empty headline copy
//   state.fav_items            : list  — favorited entries, each
//                                       {key, id, symbol, view, title, subtitle,
//                                        icon, added_ts}

View {
    width: Fill
    height: Fill
    flow: Down
    padding: 16
    gap: 1

    // ── header ──────────────────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "< 主界面"
            on_tap: || nav.pop()
        }

        Label {
            text: "收藏"
        }

        Label {
            text: "{{state.app_subtitle}}"
        }

        Label {
            text: "{{state.fav_count}}" + " 项"
        }
    }

    // ── 4 分类 chip：全部 / 行情 / 新闻 / 研究 ──────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        for c in "{{state.fav_filters}}" {
            Label {
                text: c.label
                active: "{{state.fav_filter_active}}" == c.id
                on_tap: || host.call("fav.list", {kind: c.id})
            }
        }
    }

    // ── 空态（per state.fav_empty flag copy） ──────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "{{state.fav_empty_msg}}"
        }

        Label {
            text: "去新闻 / 研究 / 行情里点 ☆ 收藏"
        }
    }

    // ── 收藏列表 ────────────────────────────────────────────────────────────
    for item in "{{state.fav_items}}" {
        View {
            width: Fill
            height: Fit
            flow: Right

            Label {
                text: item.icon
            }

            View {
                width: Fill
                height: Fit
                flow: Down

                Label {
                    text: item.title
                }

                Label {
                    text: item.subtitle
                }
            }

            Label {
                text: item.added_ts
            }

            Label {
                text: "✕"
                on_tap: || host.call("fav.toggle", {key: item.key, add: false})
            }

            on_tap: || nav.push(item.view, {key: item.key, id: item.id, symbol: item.symbol})
        }
    }
}