// _kit.octoscript — finance-brief design tokens + reusable widget helpers.
//
// Concatenated FIRST. Everything below defines tokens and helpers used by
// the 12 screens and by `_index.octoscript` (the router). Mirrors the role
// of `Octoscript-Makepad/components/flutter/_kit.octoscript`.
//
// Color palette is finance-brief's existing flat-let set, taken from
// `bundle/main.splash` (the splash entry being replaced). Tokens prefixed
// `fb_` to avoid clashing with `mod.prelude.widgets.*` and the rest of the
// makepad prelude.

// ── column palette ─────────────────────────────────────────────────────
let fb_bg          = #xfafafaff
let fb_bg_elevated = #xffffffff
let fb_ink         = #x1c1c1eff
let fb_secondary   = #x8e8e93ff
let fb_divider     = #xe5e5eaff
let fb_green_up    = #x34c759ff
let fb_red_down    = #xff3b30ff
let fb_accent      = #x007affff
let fb_accent_h    = #x0a84ffff
let fb_warn        = #xff9500ff
let fb_neutral     = #xf2f2f7ff

// ── tabbed themes (used by settings screen + dark mode toggle) ────────
let fb_dark_bg     = #x1c1c1eff
let fb_dark_ink    = #xf5f5f7ff
let fb_dark_div    = #x38383aff

// ── layout tokens ────────────────────────────────────────────────────
let fb_pad_page    = 16
let fb_gap_row     = 8
let fb_gap_col     = 12
let fb_radius_card = 12
let fb_radius_chip = 18
let fb_tile_h      = 96
let fb_bar_h       = 44

// ── state keys (the `st` namespace reads them) ──────────────────────
// Keep aligned with `bundle/workflow.octoscript` and the screens.
let stk_news_list    = "fb_news_list"
let stk_news_detail  = "fb_news_detail"
let stk_research      = "fb_research_list"
let stk_research_det = "fb_research_detail"
let stk_kline        = "fb_kline"
let stk_quote_a      = "fb_quote_a"
let stk_quote_us     = "fb_quote_us"
let stk_quote_crypto = "fb_quote_crypto"
let stk_quote_fx     = "fb_quote_fx"
let stk_favorites    = "fb_favorites"
let stk_settings     = "fb_settings"
let stk_event_stream = "fb_event_stream"
let stk_datasource   = "fb_datasource_status"
let stk_route        = "fb_route"

// ── helpers ──────────────────────────────────────────────────────────

// A single-line text widget. Carries no height (fith:1) — same reasoning as
// flutter-samples/components/flutter/_kit.octoscript:127: makepad clips a Label
// to its box, and a hand-picked height even slightly under the font's line box
// shears the descenders off. Vertical spacing belongs to the parent's spacing.
fn txt(s, size, weight, color) {
    return {t: "text", text: s, size: size, weight: weight, color: color,
            fith: 1}
}

// A bare page surface with the standard background and padding.
fn fb_page(bg, children) {
    return {t: "scroll", fillw: 1, fillh: 1, bg: bg, pad: fb_pad_page,
            spacing: fb_gap_col, c: children}
}

// A back-bar at the top of a screen; reads its label text from `copy`.
fn fb_backbar(label_text) {
    return {t: "row", fillw: 1, h: fb_bar_h, padx: 8, spacing: 8,
            aligny: 0.5, bg: fb_bg, c: [
        {t: "row", fitw: 1, h: fb_bar_h, padx: 4, spacing: 4, aligny: 0.5,
         tapto: "launcher", c: [
            txt("←", 17, 400, fb_accent),
            txt(label_text, 17, 400, fb_accent),
        ]},
    ]}
}

// A simple headline row used at the top of section cards.
fn fb_section(title) {
    return {t: "row", fillw: 1, padx: 4, pady: 8, c: [
        txt(title, 18, 500, fb_ink)
    ]}
}

// A caption used inside cards (smaller, secondary color).
fn fb_caption(text) {
    return txt(text, 12, 400, fb_secondary)
}

// A body line of text (default 14, ink color).
fn fb_body(text) {
    return txt(text, 14, 400, fb_ink)
}

// A large title (28, ink, used at the top of a screen).
fn fb_title(text) {
    return txt(text, 28, 400, fb_ink)
}

// A tile for the launcher — square-ish, filled background, label centered.
// `kind` becomes the route key (e.g. "news_list", "kline").
fn fb_tile(label, kind, accent_color) {
    return {t: "column", fillw: 1, h: fb_tile_h, radius: fb_radius_card,
            bg: fb_bg_elevated, padx: 16, pady: 16, spacing: 4,
            alignx: 0.0, aligny: 0.5, tapto: kind, c: [
        txt(label, 16, 500, fb_ink),
        fb_caption(kind),
    ]}
}

// A colored chip-style row used for tab selection (K-line period, quote tab).
// `active` is a boolean; selected chips swap colors.
fn fb_chip(label, kind, active) {
    let bg = fb_bg_elevated
    let fg = fb_ink
    if active == 1 {
        bg = fb_accent
        fg = #xffffffff
    }
    return {t: "column", fillw: 1, h: 32, padx: 12, pady: 4,
            radius: fb_radius_chip, bg: bg, alignx: 0.5, aligny: 0.5,
            tapto: kind, c: [
        txt(label, 13, 500, fg),
    ]}
}

// A single quote row: ticker, last, change% — change colored by sign.
fn fb_quote_row(symbol, last, change_pct) {
    let color = fb_secondary
    let change_str = "" + change_pct
    if change_pct > 0 {
        color = fb_green_up
        change_str = "+" + change_pct
    }
    if change_pct < 0 {
        color = fb_red_down
        change_str = "" + change_pct
    }
    return {t: "row", fillw: 1, h: 56, padx: 12, pady: 8, spacing: 8,
            aligny: 0.5, bg: fb_bg_elevated, c: [
        {t: "column", fitw: 1, c: [
            txt(symbol, 14, 500, fb_ink),
            fb_caption("行情"),
        ]},
        {t: "column", w: 96, alignx: 1.0, c: [
            txt(last, 14, 500, fb_ink),
            txt(change_str, 12, 400, color),
        ]},
    ]}
}

// A news card row: title + source line + meta.
fn fb_news_row(title, source, ago) {
    return {t: "column", fillw: 1, pad: 12, spacing: 4, radius: fb_radius_card,
            bg: fb_bg_elevated, c: [
        txt(title, 14, 500, fb_ink),
        {t: "row", spacing: 6, c: [
            txt(source, 11, 400, fb_secondary),
            txt("·", 11, 400, fb_secondary),
            txt(ago, 11, 400, fb_secondary),
        ]},
    ]}
}

