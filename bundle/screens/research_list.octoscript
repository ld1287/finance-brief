// research_list.octoscript — 研究卡列表屏。
//
// Reads `st[stk_research]` else `fb_research_seed`. Each row navigates to
// `research_detail`.

fn screen_research_list() {
    let items = fb_research_seed
    let rows = []
    let n = items.len()
    for i in n {
        let item = items[i]
        rows.push({t: "column", fillw: 1, pad: 12, spacing: 4,
                   radius: fb_radius_card, bg: fb_bg_elevated,
                   tapto: "research_detail", c: [
            txt(item[2], 14, 500, fb_ink),
            {t: "row", spacing: 6, c: [
                txt(item[1], 11, 400, fb_accent),
                txt("·", 11, 400, fb_secondary),
                txt(item[3], 11, 400, fb_secondary),
            ]},
            fb_caption(item[4]),
        ]})
    }
    return fb_page(fb_bg, [
        fb_backbar("研究卡"),
        fb_section("最新研究"),
        {t: "column", fillw: 1, spacing: 8, c: rows},
    ])
}