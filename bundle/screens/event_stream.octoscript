// event_stream.octoscript — 实时事件流屏。
//
// L1: counters / stepper are admitted here (per `docs/R-4-l0-cards.md §5`).
// Shows the latest ticks; refreshes every 1s when `fb_settings_freq=1000`.

fn screen_event_stream() {
    let items = sget(stk_event_stream, fb_event_stream_seed)
    let rows = []
    let n = items.len()
    for i in n {
        let ev = items[i]
        rows.push({t: "row", fillw: 1, h: 44, padx: 12, pady: 8,
                   spacing: 8, aligny: 0.5, bg: fb_bg_elevated, c: [
            {t: "column", w: 80, c: [
                txt(ev[0], 11, 400, fb_secondary),
            ]},
            {t: "column", fitw: 1, c: [
                txt(ev[1], 14, 500, fb_ink),
            ]},
            {t: "column", w: 96, alignx: 1.0, c: [
                txt(ev[2], 13, 500, fb_ink),
                txt(ev[3], 11, 400, fb_secondary),
            ]},
        ]})
    }
    return fb_page(fb_bg, [
        fb_backbar("事件流"),
        fb_section("实时"),
        {t: "column", fillw: 1, spacing: 8, c: rows},
        {t: "row", fillw: 1, pad: 12, spacing: 8, c: [
            fb_caption("后台由 `stream.tick` workflow 拉取；"),
            fb_caption("速率受 settings.freq_ms 控制。"),
        ]},
    ])
}