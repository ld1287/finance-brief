// finance-brief 数据源状态页 — #12 of 12 screens (L1)
// Level:  L1 (per R-3-octoscript-platform.md §5 row 12 + Q-A: 12# L1)
// Role:   系统健康监控视图 — 5 数据源 × 8 字段 状态表 + 手动刷新 + 错误明细
// Spec:   docs/R-3-octoscript-platform.md §5 + §5.1 L1 expression,
//         .todo-octoscript-rewrite-2026-10-02.md §3.6 (#12 详细架构)
// Ref:    MVP-TODO.md §5 screen #12, Q-A: 12# 是 L1, Q-F: A (5×8 字段)
//
// Layout (top → bottom):
//   1. header bar:  返回 + "数据源状态" 标题 + 手动刷新按钮
//   2. meta 行:     上次刷新时间 + 健康总数 (host L1 计算)
//   3. 表头 (8 列): 数据源 / 类型 / 状态 / 最后成功 / 最后错误 / 延迟 / 成功 / 失败
//   4. 5 数据源行:  for-loop over state.datasource.sources
//   5. 错误明细区:  当任一 status = "down" 时显示 last_err 列表
//
// Capability contracts (per capabilities.toml §1 / §2):
//   datasource.status — 聚合 5 数据源健康状态 (input: since_ts?, output: 5 rows × 8 fields)
//
// L1 区别 (per Phase 1 O-5 + Q-A):
//   - status 健康判定 (ok/degraded/down) 由 host workflow 计算, 写 state.datasource.sources[i].status
//   - healthy_count (健康数据源总数) 由 host §9 expression 计算, 写 state.datasource.healthy_count
//   - 卡片本身保持 declarative render (host state = 唯一真值源)
//   - ✅ 用 {{state.x}} 占位符 + declarative 嵌套结构
//   - ❌ 不用 `let q = "{{state.q}}"` (trip_planner L2, realize 会失败)
//   - ❌ 不用 widget-binding operator (makepad_ui_counter 非 canonical)
//
// State contract (host provides):
//   state.datasource.sources       : list — 5 rows, each {name, kind, status, last_ok_ts,
//                                                       last_err, latency_ms, success_count, err_count}
//   state.datasource.last_refresh  : text — 上次刷新时间 (格式化后字符串)
//   state.datasource.healthy_count  : text — 健康数据源总数 (host §9 expression 计算)
//   state.datasource.errors         : list — 仅含 status = "down" 的行,
//                                                each {source, last_err}
//   数据源列表 (固定 5 个 per .todo §3.6.3):
//     sina (RSS) / tencent (行情) / stooq (美股) / hyperliquid (WS) / frankfurter (FX)

View {
    width: Fill
    height: Fill
    flow: Down
    padding: 16
    gap: 1

    // ── header: 返回 + 标题 + 刷新按钮 ─────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "< 主界面"
            on_tap: || nav.pop()
        }

        Label {
            text: "数据源状态"
        }

        Label {
            text: "刷新"
            on_tap: || host.call("datasource.status")
        }
    }

    // ── meta 行: 上次刷新 + 健康总数 (L1: host §9 expression 已算) ───────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "上次刷新: {{state.datasource.last_refresh}}"
        }

        Label {
            text: "健康: {{state.datasource.healthy_count}} / 5"
        }
    }

    // ── 表头 (8 列) ────────────────────────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right

        Label {
            text: "数据源"
        }

        Label {
            text: "类型"
        }

        Label {
            text: "状态"
        }

        Label {
            text: "最后成功"
        }

        Label {
            text: "最后错误"
        }

        Label {
            text: "延迟(ms)"
        }

        Label {
            text: "成功"
        }

        Label {
            text: "失败"
        }
    }

    // ── 5 数据源行: for-loop over state.datasource.sources ─────────────────────
    // L1: 每个 src.status 由 host workflow 计算 (latency_ms > 5000 → degraded)
    for src in "{{state.datasource.sources}}" {
        View {
            width: Fill
            height: Fit
            flow: Right

            Label {
                text: src.name
            }

            Label {
                text: src.kind
            }

            Label {
                text: src.status
            }

            Label {
                text: src.last_ok_ts
            }

            Label {
                text: src.last_err
            }

            Label {
                text: src.latency_ms
            }

            Label {
                text: src.success_count
            }

            Label {
                text: src.err_count
            }

            on_tap: || host.call("datasource.toggle", {source: src.name})
        }
    }

    // ── 错误明细区: 仅显示 down 的数据源 ────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Down

        Label {
            text: "故障明细"
        }

        for err in "{{state.datasource.errors}}" {
            View {
                width: Fill
                height: Fit
                flow: Down

                Label {
                    text: err.source
                }

                Label {
                    text: err.last_err
                }
            }
        }
    }
}