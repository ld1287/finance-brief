// finance-brief navigation state + helpers
// Used by main.splash to drive which screen is shown.
// Re-render is via ui.root.render() — the host owns the render tree.

mod.lib.nav.current  = "launcher"
mod.lib.nav.history  = []

mod.lib.nav.push = fn(name){
    mod.lib.nav.history.push(mod.lib.nav.current)
    mod.lib.nav.current = name
    ui.root.render()
}

mod.lib.nav.back = fn(){
    if mod.lib.nav.history.len() == 0 { return }
    mod.lib.nav.current = mod.lib.nav.history.pop()
    ui.root.render()
}

mod.lib.nav.go_home = fn(){
    mod.lib.nav.history = []
    mod.lib.nav.current = "launcher"
    ui.root.render()
}

mod.lib.nav.is_home = fn(){
    mod.lib.nav.current == "launcher"
}
