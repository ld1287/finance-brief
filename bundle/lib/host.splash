// finance-brief host.call wrappers
// One fn per capability from bundle/capabilities.toml.
// Args are pass-through; the host runtime enforces types.

mod.lib.host.news_refresh = fn(){
    host.call("news.refresh", {limit: 30})
}

mod.lib.host.news_read = fn(id){
    host.call("news.read", {id: id})
}

mod.lib.host.quote_snapshot = fn(tab){
    host.call("quote.snapshot", {tab: tab})
}

mod.lib.host.quote_candles = fn(symbol, period){
    host.call("quote.candles", {symbol: symbol, period: period})
}

mod.lib.host.research_list = fn(){
    host.call("research.list", {})
}

mod.lib.host.research_read = fn(id){
    host.call("research.read", {id: id})
}

mod.lib.host.stream_subscribe = fn(syms, ms){
    host.call("stream.subscribe", {symbols: syms, freq_ms: ms})
}

mod.lib.host.stream_unsubscribe = fn(syms){
    host.call("stream.unsubscribe", {symbols: syms})
}

mod.lib.host.stream_freq_set = fn(ms){
    host.call("stream.frequency.set", {freq_ms: ms})
}

mod.lib.host.stream_tick = fn(){
    host.call("stream.tick", {limit: 30})
}

mod.lib.host.datasource_status = fn(){
    host.call("datasource.status", {})
}

mod.lib.host.fav_list = fn(){
    host.call("fav.list", {})
}

mod.lib.host.fav_toggle = fn(id){
    host.call("fav.toggle", {id: id})
}

mod.lib.host.settings_load = fn(){
    host.call("settings.load", {})
}

mod.lib.host.settings_save = fn(v){
    host.call("settings.save", {value: v})
}
