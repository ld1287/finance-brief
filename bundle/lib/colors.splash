// finance-brief color palette
// Imported by main.splash and any lib/* that needs colors.
// All hex literals use #xRRGGBB (lowercase x prefix).
// Each line is `mod.X = ...` so the names cross file boundaries.

mod.lib.colors.bg          = #xfafafa
mod.lib.colors.bg_elevated = #xffffff
mod.lib.colors.ink         = #x1c1c1e
mod.lib.colors.secondary   = #x8e8e93
mod.lib.colors.divider     = #xe5e5ea
mod.lib.colors.green_up    = #x34c759
mod.lib.colors.red_down    = #xff3b30
mod.lib.colors.accent      = #x007aff
mod.lib.colors.accent_h    = #x0a84ff
