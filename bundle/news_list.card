# ledger finance-brief-news-list@0.3.0
# level:   L0
# model:   news_list

source lead         sys.news(count: 1, fields: [id, title, author, points, comments, url])
source feed         sys.news(count: 20, offset: 1, fields: [id, title, author, points])
source env.locale   sys.locale()

state selected { shape: text, initial: "" }        # "" ⇒ list, story id ⇒ detail

event open_story { selected: set($value) }        # tap row ⇒ detail
event back       { selected: clear }               # back to launcher

copy masthead { class: vocabulary, en: "News Brief",        zh: "新闻简报" }
copy src      { class: vocabulary, en: "Sina Finance RSS",   zh: "新浪财经 RSS" }
copy back_lbl { class: vocabulary, en: "‹ Main",            zh: "‹ 主界面" }
copy loading  { class: vocabulary, en: "Fetching headlines…", zh: "正在获取新闻…" }
copy offline  { class: vocabulary, en: "Can't reach the feed", zh: "无法获取新闻" }
copy lead_lbl { class: vocabulary, en: "LEAD",              zh: "焦点" }
copy pts      { class: vocabulary, en: "pts",               zh: "分" }
copy cmts     { class: vocabulary, en: "comments",          zh: "评论" }
copy by       { class: vocabulary, en: "by",                zh: "作者" }

view root  Surface(pad: .page) { stream }

view stream  Col {
               when feed.$state == .pending { TextBody(text: copy.loading) }
               when feed.$state == .failed  { TextBody(text: copy.offline) }
               masthead
               headline
               feed_list
             }

view masthead  Col(gap: 2) {
                 Row(align: .center, gap: 10, on_tap: back) { TextRow(text: copy.back_lbl) }
                 TextCaption(text: copy.src)
                 TextTitle(text: copy.masthead)
               }

view headline  Card(on_tap: open_story, value: lead.0.id) {
                 TextCaption(text: copy.lead_lbl)
                 TextBody(text: lead.0.title, width: .fill)
                 Row(gap: 6) {
                   TextCaption(value: lead.0.points,   suffix: copy.pts)
                   TextCaption(value: lead.0.comments, suffix: copy.cmts)
                   TextCaption(text: copy.by)
                   TextCaption(text: lead.0.author)
                 }
               }

view feed_list  Panel {
                 for n, i in feed key n.id {
                   Row(align: .center, gap: 10, on_tap: open_story, value: n.id) {
                     TextRow(text: n.title, width: .fill)
                     Row(gap: 6) {
                       TextCaption(value: n.points, suffix: copy.pts)
                       TextCaption(text: copy.by)
                       TextCaption(text: n.author)
                     }
                   }
                   Rule()
                 }
               }
