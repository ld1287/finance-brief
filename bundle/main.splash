let ink = #xf2f4f8
let secondary = #x8e93a3
let up = #xe64340
let down = #x2ecc71
let flat = #x8e93a3

// ---------------------------------------------------------------- helpers

fn padn(n, dec){
    let s = "" + n
    while s.len() < dec { s = "0" + s }
    s
}

fn starts(txt, ch){
    txt.search(ch) == 0
}

// Split before scaling: `round(a * m)` at m = 10^4 loses the low bits of a
// five-digit price and produced values like "83745.0-16" for BTC.
fn fixed(v, dec){
    let neg = v < 0
    let a = abs(v)
    let m = pow(10, dec)
    let whole = floor(a)
    let frac = round((a - whole) * m)
    if frac >= m { whole = whole + 1 frac = 0 }
    let s = "" + whole + "." + padn(frac, dec)
    if neg { "-" + s } else { s }
}

fn pct_str(v){
    let s = fixed(abs(v), 2)
    if v > 0.0001 { "+" + s + "%" }
    elif v < -0.0001 { "-" + s + "%" }
    else { s + "%" }
}

fn pct_color(v){
    if v > 0.0001 { up }
    elif v < -0.0001 { down }
    else { flat }
}

fn hm(ts){
    if ts == 0 { return "" }
    let t = local_time(ts)
    padn(t.month, 2) + "-" + padn(t.day, 2) + " " + padn(t.hour, 2) + ":" + padn(t.minute, 2)
}

fn fetch_get(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-FinanceBrief/0.2"}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn fetch_post(url, payload){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.POST headers: {"Content-Type": "application/json" "User-Agent": "OctoSense-FinanceBrief/0.2"} body: payload}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

// Quote feeds are plain text with GBK names; display names are ours and only
// the ASCII numbers are read. Sina's hq.sinajs.cn was tried first and aborts
// with a TLS `unexpected eof` in this client, so Tencent's qt.gtimg.cn is used.
fn fetch_q(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "Mozilla/5.0"}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

fn good(res){
    res != nil && res.status_code < 400 && res.body != nil
}

// Read an object field without touching a key that is not there. In Splash,
// reading a missing property is an error, not nil, so `if o.k != nil` cannot
// guard it; enumerating the object's own keys can. Feed items are not uniform
// (one Sina story in 60 has no media_name), so every remote field read uses this.
fn get(o, key, fallback){
    if o == nil { return fallback }
    for k v in o { if k == key { return v } }
    fallback
}

fn num(v){
    let f = ("" + v).to_f64()
    if f == f { f } else { 0 }
}

// Rows that came from the built-in sample must never look like live prices.
fn sub_of(r){
    if starts(r.id, "sample:") { return "示例数据 · 非实时" }
    r.sub
}

// ---------------------------------------------------------------- settings I/O (v0.2.0)

fn load_settings(){
    if fs.exists("settings.json") {
        let v = fs.read("settings.json").parse_json()
        if v != nil {
            let t = get(v, "theme", "")
            if t == "dark" || t == "light" || t == "auto" { settings.theme = t }
            let h = get(v, "hosts", nil)
            if h != nil {
                if get(h, "sina", 0) == 1 { settings.hosts.sina = 1 } else { settings.hosts.sina = 0 }
                if get(h, "tencent", 0) == 1 { settings.hosts.tencent = 1 } else { settings.hosts.tencent = 0 }
                if get(h, "hyperliquid", 0) == 1 { settings.hosts.hyperliquid = 1 } else { settings.hosts.hyperliquid = 0 }
                if get(h, "frankfurter", 0) == 1 { settings.hosts.frankfurter = 1 } else { settings.hosts.frankfurter = 0 }
            }
        }
    }
}

fn save_settings(){
    fs.write("settings.json", settings.to_json())
}

fn host_val(name){
    if name == "sina" { return settings.hosts.sina }
    if name == "tencent" { return settings.hosts.tencent }
    if name == "hyperliquid" { return settings.hosts.hyperliquid }
    if name == "frankfurter" { return settings.hosts.frankfurter }
    0
}

fn set_host(name, val){
    if name == "sina" { settings.hosts.sina = val return }
    if name == "tencent" { settings.hosts.tencent = val return }
    if name == "hyperliquid" { settings.hosts.hyperliquid = val return }
    if name == "frankfurter" { settings.hosts.frankfurter = val return }
}

fn toggle_setting(name){
    if host_val(name) == 1 { set_host(name, 0) } else { set_host(name, 1) }
    save_settings()
    if ui.settings_pane != nil { ui.settings_pane.render() }
}

fn set_theme(name){
    if name == "dark" || name == "light" || name == "auto" { settings.theme = name }
    save_settings()
    if ui.settings_pane != nil { ui.settings_pane.render() }
}

// ---------------------------------------------------------------- view router (v0.2.0)

fn refresh_pane(){
    if ui == nil { return }
    let vis_launcher = view == "launcher"
    let vis_main = view == "main"
    let vis_favs = view == "favs"
    let vis_settings = view == "settings"
    let vis_about = view == "about"
    let vis_research = view == "research"
    let vis_research_detail = view == "research_detail"
    if ui.launcher_pane != nil { ui.launcher_pane.set_visible(vis_launcher) }
    if ui.main_pane != nil { ui.main_pane.set_visible(vis_main) }
    if ui.favs_pane != nil { ui.favs_pane.set_visible(vis_favs) }
    if ui.settings_pane != nil { ui.settings_pane.set_visible(vis_settings) }
    if ui.about_pane != nil { ui.about_pane.set_visible(vis_about) }
    if ui.research_pane != nil { ui.research_pane.set_visible(vis_research) }
    if ui.research_detail_pane != nil { ui.research_detail_pane.set_visible(vis_research_detail) }
    if vis_launcher && ui.launcher_pane != nil { ui.launcher_pane.render() }
    if vis_main && ui.main_pane != nil { ui.main_pane.render() }
    if vis_favs && ui.favs_pane != nil { ui.favs_pane.render() }
    if vis_settings && ui.settings_pane != nil { ui.settings_pane.render() }
    if vis_about && ui.about_pane != nil { ui.about_pane.render() }
    if vis_research && ui.research_pane != nil { ui.research_pane.render() }
    if vis_research_detail && ui.research_detail_pane != nil { ui.research_detail_pane.render() }
}

fn pick_view(v){
    view = v
    if v != "main" { detail = nil }
    refresh_pane()
}

// Launcher tile: open main pane on a given tab. "行情看盘" defaults to A股.
fn open_tab(tid){
    tab = tid
    detail = nil
    view = "main"
    rebuild()
    refresh_pane()
    if ui.tabbar != nil { ui.tabbar.render() }
    if ui.list != nil { ui.list.render() }
    sync_status()
}

