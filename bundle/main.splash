let research_filter = "all"
let research_idx = -1
let research_filters = [
    {id: "all" label: "全部"}
    {id: "policy" label: "政策"}
    {id: "earnings" label: "财报"}
    {id: "anomaly" label: "异动"}
    {id: "macro" label: "宏观"}
    {id: "onchain" label: "链上"}
]
let research_cats = ["policy" "earnings" "anomaly" "macro" "onchain"]
let settings = {theme: "dark" hosts: {sina: 1 tencent: 1 hyperliquid: 1 frankfurter: 1}}

// `tkey` selects the statement, `tick` is what we show.
let a_syms = [
    {tkey: "sh000001" name: "上证指数" tick: "000001" dec: 2}
    {tkey: "sz399001" name: "深证成指" tick: "399001" dec: 2}
