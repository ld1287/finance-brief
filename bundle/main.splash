fn rows_for(tid){
    if tid == "a" { return a_rows }
    if tid == "us" { return us_rows }
    if tid == "crypto" { return crypto_rows }
    if tid == "fx" { return fx_rows }
    if tid == "fav" { return favs }
    if tid == "quotes" {
        if quote_chip == "a" { return a_rows }
        if quote_chip == "us" { return us_rows }
        if quote_chip == "crypto" { return crypto_rows }
        if quote_chip == "fx" { return fx_rows }
        return a_rows
    }
    news_rows
}

fn set_rows(tid, v){
    if tid == "a" { a_rows = v return }
    if tid == "us" { us_rows = v return }
    if tid == "crypto" { crypto_rows = v return }
    if tid == "fx" { fx_rows = v return }
    if tid == "fav" { favs = v return }
    if tid == "quotes" {
        if quote_chip == "a" { a_rows = v return }
        if quote_chip == "us" { us_rows = v return }
        if quote_chip == "crypto" { crypto_rows = v return }
        if quote_chip == "fx" { fx_rows = v return }
        a_rows = v
        return
    }
    news_rows = v
}

fn err_for(tid){
    if tid == "a" { return a_err }
    if tid == "us" { return us_err }
    if tid == "crypto" { return crypto_err }
    if tid == "fx" { return fx_err }
    if tid == "quotes" {
        if quote_chip == "a" { return a_err }
        if quote_chip == "us" { return us_err }
        if quote_chip == "crypto" { return crypto_err }
        if quote_chip == "fx" { return fx_err }
        return a_err
    }
    news_err
}

fn set_err(tid, v){
    if tid == "a" { a_err = v return }
    if tid == "us" { us_err = v return }
    if tid == "crypto" { crypto_err = v return }
    if tid == "fx" { fx_err = v return }
    if tid == "quotes" {
        if quote_chip == "a" { a_err = v return }
        if quote_chip == "us" { us_err = v return }
        if quote_chip == "crypto" { crypto_err = v return }
        if quote_chip == "fx" { fx_err = v return }
        a_err = v
        return
    }
    news_err = v
}

