fn load_sample(){
    for t in tabs {
        if t.id == "fav" { continue }
        if rows_for(t.id).len() == 0 { set_rows(t.id, sample_for(t.id)) }
    }
}

// ---------------------------------------------------------------- loaders

// Replace every occurrence of `sep` (String.replace only does the first).
fn replace_all(s, sep, rep){
    let parts = s.split(sep)
    let out = ""
    for i p in parts {
        if i > 0 { out = out + rep }
        out = out + p
    }
    out
}

// Sina escapes slashes as `\/`. Splash's parse_json does not know that escape
// and drops it together with the next character (`\/stock\/usstock\/c\/` came
// out as `ockck`), so load_news unescapes the raw body before parsing. This
// only trims what is left: stray tabs / newlines and outer whitespace.
fn clean_url(u){
    let s = "" + u
    s = replace_all(s, "\t", "")
    s = replace_all(s, "\n", "")
    s = replace_all(s, "\r", "")
    s.trim()
}

// Stable across refreshes: oid, else url, else title. Never the feed index.
fn row_news(it, idx){
    let title = "" + get(it, "title", "")
    let media = "" + get(it, "media_name", "")
    let intro = "" + get(it, "intro", "")
    let url = clean_url(get(it, "url", ""))
    let oid = "" + get(it, "oid", "")
    let ts = 0
    let raw = get(it, "ctime", "")
    if raw != "" { ts = num(raw) }
    let id = "news:" + oid
    if oid == "" {
        if url != "" { id = "news:u:" + url } else { id = "news:t:" + title }
    }
    {id: id kind: "news" title: title sub: media metric: "" pct: 0 body: intro url: url ts: ts}
}

// G2 migration: HTTP is now issued through the low-level net.http_request
// event surface so the body parser can later be swapped for a native
// host.call. Parsing is still a local fallback (parse_sina_fallback / sina_tag
// below) - the next G-agent turns it into host.call("news.parse", {body: ...}).
fn load_news(){
    if host_val("sina") == 0 {
        if news_rows.len() == 0 { news_rows = sample_for("news") }
        news_err = false
        return
    }
    let p = promise()
    let url = "https://feed.mix.sina.com.cn/api/rolls/list?channel=finance&num=20"
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-FinanceBrief/0.3"}}) do net.HttpEvents{
        on_response: |res| {
            if !good(res) {
                news_err = true
                p.resolve(nil)
                return
            }
            // TODO: native parse - let parsed = host.call("news.parse", {body: res.body})
            // 临时 fallback: 直接把 body 作为 news_rows (splash 不在 parse)
            news_rows = parse_sina_fallback(res.body)
            news_err = false
            p.resolve(p)
        }
        on_error: |_err| {
            news_err = true
            p.resolve(nil)
        }
    }
    p
}

// 临时 fallback: splash 内的极简 sina parse（用字符串扫描）
fn parse_sina_fallback(body){
    let out = []
    let rest = body
    while true {
        let s = rest.find("<" + "item" + ">")
        if s == nil { break }
        let after = rest[s + 6:]
        let e = after.find("</" + "item" + ">")
        if e == nil { break }
        let item = after[:e]
        let title = sina_tag(item, "title")
        let link = sina_tag(item, "link")
        let source = sina_tag(item, "media_name")
        let intro = sina_tag(item, "intro")
        out.push({id: "news:" + ("" + out.len()) title: title url: link source: source ts: 0 body: intro})
        rest = after[e + 7:]
    }
    return out
}
fn sina_tag(item, tag){
    let open = "<" + tag + ">"
    let close = "</" + tag + ">"
    let s = item.find(open)
    if s == nil { return "" }
    let after = item[s + open.len():]
    let e = after.find(close)
    if e == nil { return "" }
    let raw = after[:e]
    return raw.replace_all("&amp;", "&").replace_all("&lt;", "<").replace_all("&gt;", ">").replace_all("&quot;", "\"")
}

// Tencent quote feed: `v_<code>="…~name~code~current~prev~open~…~time~chg~pct~high~low~…";`
// per symbol, separated by ";". Index 3 is the current price, 32 the change %.
//
// G3 migration: HTTP is now issued through the low-level net.http_request
// event surface so the body parser can later be swapped for a native
// host.call. Parsing is still a local fallback (parse_tencent_fallback
// below) - the next G-agent turns it into
// host.call("quotes.parse_tencent", {market: tid, body: res.body}).
fn load_tencent(tid, syms, listed){
    if host_val("tencent") == 0 {
        if rows_for(tid).len() == 0 { set_rows(tid, sample_for(tid)) }
        set_err(tid, false)
        return
    }
    let p = promise()
    let url = "https://qt.gtimg.cn/q=" + listed
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-FinanceBrief/0.3"}}) do net.HttpEvents{
        on_response: |res| {
            if !good(res) {
                if rows_for(tid).len() == 0 { set_rows(tid, sample_for(tid)) }
                set_err(tid, true)
                p.resolve(nil)
                return
            }
            // TODO: native parse - let parsed = host.call("quotes.parse_tencent", {market: tid, body: res.body})
            // 临时 fallback: splash 内的极简 tencent parse（只填 id）
            let parsed = parse_tencent_fallback(tid, res.body.to_string())
            if parsed.len() > 0 {
                set_rows(tid, parsed)
                set_err(tid, false)
            } else {
                if rows_for(tid).len() == 0 { set_rows(tid, sample_for(tid)) }
                set_err(tid, true)
            }
            p.resolve(p)
        }
        on_error: |_err| {
            if rows_for(tid).len() == 0 { set_rows(tid, sample_for(tid)) }
            set_err(tid, true)
            p.resolve(nil)
        }
    }
    p
}

// 临时 fallback: splash 内的极简 tencent parse（只填 id，name/price/pct 留到 native）
fn parse_tencent_fallback(tid, body){
    let out = []
    let rest = body
    while true {
        let s = rest.find("=\"")
        if s == nil { break }
        let after = rest[s + 2:]
        let m = after.find('"')
        if m == nil { break }
        let content = after[:m]
        out.push({id: tid + ":" + content title: "" sub: "" metric: 0 pct: 0 body: "" url: "" ts: 0})
        rest = after[m:]
    }
    return out
}

// 临时 fallback: splash 内的极简 hyperliquid parse（[meta, ctxs] → splash row）
fn parse_hyperliquid_fallback(body){
    let out = []
    let d = body.parse_json()
    if d == nil { return out }
    if d.len() < 2 { return out }
    let uni = get(d[0], "universe", nil)
    let ctx = d[1]
    if uni == nil { return out }
    if ctx == nil { return out }
    if ctx.len() == 0 { return out }
    let n = 12
    if uni.len() < n { n = uni.len() }
    if ctx.len() < n { n = ctx.len() }
    for i in n {
        let name = "" + get(uni[i], "name", "")
        if name == "" { continue }
        let mark = num(get(ctx[i], "markPx", 0))
        let prev = num(get(ctx[i], "prevDayPx", 0))
        let pct = 0
        if prev > 0 { pct = (mark - prev) / prev * 100 }
        out.push({id: "crypto:" + name kind: "quote" title: name sub: "HL 永续" metric: fixed(mark, 4) pct: pct body: "" url: "" ts: 0})
    }
    return out
}

// 临时 fallback: splash 内的极简 frankfurter parse（rates → splash row）
fn parse_frankfurter_fallback(body){
    let out = []
    let d = body.parse_json()
    if d == nil { return out }
    let rates = get(d, "rates", nil)
    if rates == nil { return out }
    for k v in rates {
        out.push({id: "fx:" + k kind: "quote" title: "USD/" + k sub: "参考汇率" metric: fixed(num(v), 4) pct: 0 body: "" url: "" ts: 0})
    }
    return out
}

// 临时 fallback: splash 内的极简 nasdaq parse（primaryData/secondaryData → splash row）
fn parse_nasdaq_fallback(tid, tick, body){
    let txt = body.replace_all("\\/", "/")
    let d = json_root(txt, "{")
    if d == nil { return nil }
    let data = get(d, "data", nil)
    if data == nil { return nil }
    let primary = get(data, "primaryData", nil)
    if primary == nil { return nil }
    let price_s = strip_dollar(get(primary, "lastSalePrice", ""))
    let price = num(price_s)
    if price <= 0 { return nil }
    let pct_s = get(primary, "percentageChange", "")
    let pct = num((pct_s.replace("%", "")).trim())
    let ms = get(primary, "marketStatus", "")
    let sub_full = tick
    if ms != "" { sub_full = ms + " · " + tick }
    let body_txt = ""
    let secondary = get(data, "secondaryData", nil)
    if secondary != nil {
        let prev_s = strip_dollar(get(secondary, "lastSalePrice", ""))
        let prev = num(prev_s)
        if prev > 0 { body_txt = "昨收 " + fixed(prev, 2) }
    }
    return {id: tid + ":" + tick kind: "quote" title: tick sub: sub_full metric: fixed(price, 2) pct: pct body: body_txt url: "" ts: 0}
}

// Nasdaq JSON feed: `https://api.nasdaq.com/api/quote/{tick}/info?assetclass=stocks`.
// R-1 client constraints: User-Agent must be set (no UA → 000); must NOT send Origin/Referer.
// primaryData.lastSalePrice has "$" prefix; percentageChange has "+"/"-" prefix and trailing "%".
// secondaryData.lastSalePrice is yesterday's close for the open/close line.
// percentageChange is kept SIGNED — `pct_color` (and the up/down color of the
// row) depends on `pct > 0` vs `< 0`, so stripping the sign would always tint
// every US row red/green regardless of direction.
//
// G6 migration: HTTP is now issued through the low-level net.http_request
// event surface so the body parser can later be swapped for a native
// host.call. Parsing is still a local fallback (parse_nasdaq_fallback
// below) - the next G-agent turns it into
// host.call("quotes.parse_nasdaq", {market: tid, tick: sy.tick, body: res.body}).
fn load_nasdaq(tid, syms){
    if host_val("nasdaq") == 0 {
        if rows_for(tid).len() == 0 { set_rows(tid, sample_for(tid)) }
        set_err(tid, false)
        return
    }
    let out = []
    for sy in syms {
        let url = "https://api.nasdaq.com/api/quote/" + sy.tick + "/info?assetclass=stocks"
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-FinanceBrief/0.3"}}) do net.HttpEvents{
            on_response: |res| {
                if !good(res) { return }
                let row = parse_nasdaq_fallback(tid, sy.tick, res.body.to_string())
                if row != nil { out.push(row) }
            }
            on_error: |_err| { /* sample fallback kept by outer caller */ }
        }
    }
    if out.len() > 0 {
        set_rows(tid, out)
        set_err(tid, false)
        fs.write("cache_" + tid + ".json", out.to_json())
    }
}

// Hyperliquid: [0].universe[i].name pairs with [1][i].markPx / prevDayPx.
//
// G4 migration: HTTP is now issued through the low-level net.http_request
// event surface so the body parser can later be swapped for a native
// host.call. Parsing is still a local fallback (parse_hyperliquid_fallback
// below) - the next G-agent turns it into
// host.call("crypto.parse_hyperliquid", {body: res.body}).
fn load_crypto(){
    if host_val("hyperliquid") == 0 {
        if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
        crypto_err = false
        return
    }
    let p = promise()
    let url = "https://api.hyperliquid.xyz/info"
    let payload = "{\"type\":\"metaAndAssetCtxs\"}"
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.POST headers: {"Content-Type": "application/json" "User-Agent": "OctoSense-FinanceBrief/0.3"} body: payload}) do net.HttpEvents{
        on_response: |res| {
            if !good(res) {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            let txt = ("" + res.body).replace_all("\\/", "/")
            if !starts(txt.trim(), "[") {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            let d = txt.parse_json()
            if d == nil {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            if d.len() < 2 {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            let uni = get(d[0], "universe", nil)
            let ctx = d[1]
            if uni == nil {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            if ctx == nil {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            if ctx.len() == 0 {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            let parsed = parse_hyperliquid_fallback(txt)
            if parsed.len() == 0 {
                if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
                crypto_err = true
                p.resolve(nil)
                return
            }
            crypto_rows = parsed
            crypto_err = false
            fs.write("cache_crypto.json", parsed.to_json())
            p.resolve(p)
        }
        on_error: |_err| {
            if crypto_rows.len() == 0 { crypto_rows = sample_for("crypto") }
            crypto_err = true
            p.resolve(nil)
        }
    }
    p
}

// G5 migration: HTTP is now issued through the low-level net.http_request
// event surface so the body parser can later be swapped for a native
// host.call. Parsing is still a local fallback (parse_frankfurter_fallback
// below) - the next G-agent turns it into
// host.call("fx.parse_frankfurter", {body: res.body}).
fn load_fx(){
    if host_val("frankfurter") == 0 {
        if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
        fx_err = false
        return
    }
    let p = promise()
    let url = "https://api.frankfurter.dev/v1/latest?base=USD&symbols=CNY,EUR,JPY,GBP,HKD"
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-FinanceBrief/0.3"} body: ""}) do net.HttpEvents{
        on_response: |res| {
            if !good(res) {
                if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
                fx_err = true
                p.resolve(nil)
                return
            }
            let txt = ("" + res.body).replace_all("\\/", "/")
            if !starts(txt.trim(), "{") {
                if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
                fx_err = true
                p.resolve(nil)
                return
            }
            let d = txt.parse_json()
            if d == nil {
                if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
                fx_err = true
                p.resolve(nil)
                return
            }
            let rates = get(d, "rates", nil)
            if rates == nil {
                if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
                fx_err = true
                p.resolve(nil)
                return
            }
            let parsed = parse_frankfurter_fallback(txt)
            if parsed.len() == 0 {
                if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
                fx_err = true
                p.resolve(nil)
                return
            }
            fx_rows = parsed
            fx_err = false
            fs.write("cache_fx.json", parsed.to_json())
            p.resolve(p)
        }
        on_error: |_err| {
            if fx_rows.len() == 0 { fx_rows = sample_for("fx") }
            fx_err = true
            p.resolve(nil)
        }
    }
    p
}

// ---------------------------------------------------------------- state

fn load_state(){
    if fs.exists("favs.json") {
        let v = json_root(fs.read("favs.json"), "[")
        if v != nil { favs = v }
    }
    for t in tabs {
        if t.id == "fav" { continue }
        let path = "cache_" + t.id + ".json"
        if fs.exists(path) {
            let v = json_root(fs.read(path), "[")
            if v != nil { if v.len() > 0 { set_rows(t.id, v) cached = true } }
        }
    }
}

fn news_keywords(f){
    if f == "macro" { return ["央行" "GDP" "CPI" "PMI" "利率"] }
    if f == "ashare" { return ["沪指" "深成指" "沪深" "创业板" "A股" "上证" "深证"] }
    if f == "crypto" { return ["比特币" "BTC" "ETH" "加密"] }
    if f == "fx" { return ["美元" "汇率" "人民币" "日元"] }
    []
}

// Case-insensitive contains (SCRIPT-API.md): BTC/btc, GDP/gdp all match.
// Keywords hold no regex metacharacters, so they are used unescaped.
fn kw_hit(title, kw){
    regex(kw, "i").test(title)
}

fn news_match(title, f){
    if f == "all" { return true }
    for kw in news_keywords(f) { if kw_hit(title, kw) { return true } }
    false
}

fn rebuild(){
    let src = rows_for(tab)
    if tab != "news" || news_filter == "all" {
        rows = src
        return
    }
    let out = []
    for r in src { if news_match("" + r.title, news_filter) { out.push(r) } }
    rows = out
}

fn set_news_filter(f){
    news_filter = f
    detail = nil
    rebuild()
    if ui.list != nil { ui.list.render() }
}

// ---------------------------------------------------------------- research cards (D-2)

fn research_keywords(c){
    if c == "policy" { return ["央行" "政策" "决议" "证监会" "监管" "国务院"] }
    if c == "earnings" { return ["财报" "业绩" "营收" "净利"] }
    if c == "anomaly" { return ["异动" "拉升" "跳水" "暴涨" "暴跌" "涨停" "跌停"] }
    if c == "macro" { return ["GDP" "CPI" "PPI" "PMI" "失业率" "利率"] }
    if c == "onchain" { return ["链上" "比特币" "BTC" "ETH" "区块链"] }
    []
}

// First category (in research_cats order) whose keyword appears in the title; "" if none.
fn research_cat_of(title){
    for c in research_cats {
        for kw in research_keywords(c) { if kw_hit(title, kw) { return c } }
    }
    ""
}

fn research_label(c){
    if c == "policy" { return "政策公告" }
    if c == "earnings" { return "财报解读" }
    if c == "anomaly" { return "行情异动" }
    if c == "macro" { return "宏观数据" }
    if c == "onchain" { return "链上数据" }
    "其他"
}

fn research_color(c){
    if c == "policy" { return #x3b82f6 }
    if c == "earnings" { return #xf59e0b }
    if c == "anomaly" { return #xef4444 }
    if c == "macro" { return #x10b981 }
    if c == "onchain" { return #x8b5cf6 }
    #x6b7280
}

fn derive_research(){
    let out = []
    for r in news_rows {
        let c = research_cat_of("" + r.title)
        if c != "" { out.push({cat: c row: r}) }
    }
    research_rows = out
}

fn research_list(){
    if research_filter == "all" { return research_rows }
    let out = []
    for e in research_rows { if e.cat == research_filter { out.push(e) } }
    out
}

// nil once a refresh has dropped the card; the detail pane then says so.
fn research_cur(){
    if research_id == "" { return nil }
    for e in research_rows { if e.row.id == research_id { return e } }
    nil
}

fn open_research(){
    research_id = ""
    pick_view("research")
}

fn set_research_filter(f){
    research_filter = f
    research_id = ""
    if ui.research_pane != nil { ui.research_pane.render() }
}

fn open_research_detail(i){
    let lst = research_list()
    if i < 0 { return }
    if i >= lst.len() { return }
    research_id = lst[i].row.id
    pick_view("research_detail")
}

fn toggle_research_fav(r){
    toggle_fav(r)
    if ui.research_detail_pane != nil { ui.research_detail_pane.render() }
}

// "来源：<媒体> · <时间>"; the time part is dropped for undated (sample) rows.
// News rows always carry sub/ts (row_news, sample_for), so read them directly.
fn source_line(d){
    let s = sub_of(d)
    if s == "" { s = "未知来源" }
    let t = hm(d.ts)
    if t == "" { "来源：" + s } else { "来源：" + s + " · " + t }
}

fn status_line(){
    if busy { return "刷新中…" }
    if tab == "fav" { return "已收藏 " + ("" + favs.len()) + " 条" }
    if err_for(tab) { return "来源暂时不可用，显示缓存 / 示例数据" }
    if cached { return "显示上次缓存，点「刷新」更新" }
    if updated > 0 { return "更新于 " + hm(updated) }
    "点右上角「刷新」获取最新数据"
}

fn sync_status(){ ui.status.set_text(status_line()) }

fn refresh(){
    if busy { return }
    busy = true
    detail = nil
    cached = false
    sync_status()
    if ui.list != nil { ui.list.render() }
    load_news()
    load_tencent("a", a_syms, "sh000001,sz399001,sh000300,sh600519,sz000858")
    load_nasdaq("us", us_syms)
    load_crypto()
    load_fx()
    busy = false
    updated = time_now()
    derive_research()
    rebuild()
    sync_status()
    if ui.list != nil { ui.list.render() }
    if view == "launcher" && ui.launcher_pane != nil { ui.launcher_pane.render() }
    if view == "research" && ui.research_pane != nil { ui.research_pane.render() }
    if view == "research_detail" && ui.research_detail_pane != nil { ui.research_detail_pane.render() }
    if tab == "kline" { refresh_kline() }
}

fn pick(id){
    if id == "kline" {
        let r = rows_for(quote_chip)
        if r.len() > 0 {
            detail = r[0]
            tab = quote_chip
            view = "main"
            rebuild()
            refresh_pane()
            if ui.tabbar != nil { ui.tabbar.render() }
            if ui.list != nil { ui.list.render() }
            sync_status()
            return
        }
        return
    }
    tab = id
    detail = nil
    // Tab "fav" is the existing tabbar path into the favs view; everything
    // else stays on the main pane.
    if id == "fav" { view = "favs" } else { view = "main" }
    rebuild()
    refresh_pane()
    if ui.tabbar != nil { ui.tabbar.render() }
    if ui.list != nil { ui.list.render() }
    sync_status()
}

// I-7: 行情 chip 切换（仅切数据源，不切 view）。
fn pick_quote(id){
    quote_chip = id
    detail = nil
    refresh()
}

fn refresh_kline(){
    k_candles = synth_candles(100)
    k_loaded = true
    if ui.k_chart != nil {
        ui.k_chart.set_data(k_candles)
    }
    if ui.list != nil { ui.list.render() }
}

fn switch_kperiod(p){
    k_period = p
    refresh_kline()
}

// C2: quotes_pane 独立的 tab/period 切换与刷新（不复用 quotes tab 的 quote_chip/k_period）。
fn pick_quote_pane(t){
    quote_pane_tab = t
    refresh_quote_pane()
}

fn switch_quote_pane_period(p){
    quote_pane_period = p
    refresh_quote_pane()
}

fn refresh_quote_pane(){
    quote_pane_candles = synth_candles(120)
    quote_pane_loaded = true
    if ui.quote_pane_chart != nil { ui.quote_pane_chart.set_data(quote_pane_candles) }
}

fn open_detail(i){
    if i < 0 { return }
    if i >= rows.len() { return }
    detail = rows[i]
    if ui.list != nil { ui.list.render() }
    if detail != nil && detail.kind == "quote" {
        k_period = "1m"
        k_candles = synth_candles(100)
        k_loaded = true
        if ui.k_chart != nil { ui.k_chart.set_data(k_candles) }
    }
}

fn close_detail(){
    detail = nil
    if ui.list != nil { ui.list.render() }
}

fn is_fav(id){
    for f in favs { if f.id == id { return true } }
    false
}

fn toggle_fav(r){
    if is_fav(r.id) { favs.retain(|f| f.id != r.id) } else { favs.push(r) }
    fs.write("favs.json", favs.to_json())
    rebuild()
    if ui.list != nil { ui.list.render() }
    if ui.favs_pane != nil { ui.favs_pane.render() }
    sync_status()
}

fn boot(){
    // Show the launcher first so a failure further down cannot leave another pane up.
    refresh_pane()
    load_state()
    load_settings()
    load_sample()
    derive_research()
    rebuild()
    refresh_pane()
    refresh()
}
start_timeout(0.05, || boot())
start_interval(600, || refresh())

