let a_rows = []
let us_rows = []
let crypto_rows = []
let fx_rows = []

let news_err = false
let a_err = false
let us_err = false
let crypto_err = false
let fx_err = false

let favs = []
let rows = []
let tab = "news"
let detail = nil
let busy = false
let updated = 0
let cached = false

