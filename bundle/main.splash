// finance-brief main entry — single-file splash application (B-0 flat-let rewrite).
// Previous inlining kept `mod.lib.X.Y` dotted assignments that the splash L0
// dialect does not support (runtime: "property lib not found"). This rewrite
// adopts the flat pattern that worked in the initial commit ba85d44 (the
// 1059-line main.splash that ran without errors): top-level `let X = ...` for
// state + top-level `fn name(args) { ... }` whose bodies mutate the shared
// objects directly. lib/ directory is gone; this file is self-contained.
// History reference: ba85d44..4a30bb5 changed `let X = ...` into `mod.lib.X.Y`.

// ── colors ──────────────────────────────────────────────────────
let colors = {
    bg:          #xfafafa
    bg_elevated: #xffffff
    ink:         #x1c1c1e
    secondary:   #x8e8e93
    divider:     #xe5e5ea
    green_up:    #x34c759
    red_down:    #xff3b30
    accent:      #x007aff
    accent_h:    #x0a84ff
}

// ── data state (P0: wired to host.call) ────────────────────────
// Each screen has data_X (host.call result) + loaded_X (one-shot flag)
// to trigger first-load on screen entry without async/await.
let data_news_list         = []
let data_news_detail       = {}
let data_research_list     = []
let data_research_detail   = {}
let data_kline             = {candles: [], symbol: "sh000001", period: "1d"}
let data_favorites         = []
let data_settings          = {theme: "light", freq_ms: 5000, font_size: "md"}
let data_event_stream      = []
let data_datasource_status = []
let data_disclaimer        = {license: "Apache-2.0", sources: "sina/tencent/hyperliquid/frankfurter/stooq"}

let loaded_news_list         = false
let loaded_news_detail       = false
let loaded_research_list     = false
let loaded_research_detail   = false
let loaded_kline             = false
let loaded_favorites         = false
let loaded_settings          = false
let loaded_event_stream      = false
let loaded_datasource_status = false
let loaded_disclaimer        = false

// ── nav ─────────────────────────────────────────────────────────
let nav = {
    current: "launcher"
    history: []
}

nav.push = fn(name){
    nav.history.push(nav.current)
    nav.current = name
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.back = fn(){
    if nav.history.len() == 0 { return }
    nav.current = nav.history.pop()
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.go_home = fn(){
    nav.history = []
    nav.current = "launcher"
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.is_home = fn(){
    nav.current == "launcher"
}

// ── host ────────────────────────────────────────────────────────
// 15 host.call wrappers, one per capability listed in bundle/capabilities.toml.
// Defined as top-level `let host_X = fn(args) { ... }` so they sit alongside
// `colors` / `nav` without any module nesting or dynamic-key writes.

let host_news_refresh = fn(){
    host.call("news.refresh", {limit: 30})
}

let host_news_read = fn(id){
    host.call("news.read", {id: id})
}

let host_quote_snapshot = fn(tab){
    host.call("quote.snapshot", {tab: tab})
}

let host_quote_candles = fn(symbol, period){
    host.call("quote.candles", {symbol: symbol, period: period})
}

let host_research_list = fn(){
    host.call("research.list", {})
}

let host_research_read = fn(id){
    host.call("research.read", {id: id})
}

let host_stream_subscribe = fn(syms, ms){
    host.call("stream.subscribe", {symbols: syms, freq_ms: ms})
}

let host_stream_unsubscribe = fn(syms){
    host.call("stream.unsubscribe", {symbols: syms})
}

let host_stream_freq_set = fn(ms){
    host.call("stream.frequency.set", {freq_ms: ms})
}

let host_stream_tick = fn(){
    host.call("stream.tick", {limit: 30})
}

let host_datasource_status = fn(){
    host.call("datasource.status", {})
}

let host_fav_list = fn(){
    host.call("fav.list", {})
}

let host_fav_toggle = fn(id){
    host.call("fav.toggle", {id: id})
}

let host_settings_load = fn(){
    host.call("settings.load", {})
}

let host_settings_save = fn(v){
    host.call("settings.save", {value: v})
}

// ── launcher + header ───────────────────────────────────────────
// All `mod.lib.colors.X` → `colors.X`; `mod.lib.nav.X()` → `nav.X()`.
// No `use` statements (`use` is a reserved word in this splash dialect).

// ── header ─────────────────────────────────────────────────────
fn render_header(){
    View{width: Fill height: Fit flow: Right spacing: 8 padding: 16 align: Align{y: 0.5}
        if nav.is_home() == false {
            ButtonFlat{text: "← 返回" height: 36 on_click: || nav.back()
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 18.0 border_size: 1.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
        }
        Label{width: Fill text: "财经简报"
            draw_text.color: colors.ink
            draw_text.text_style.font_size: 22}
    }
}

// ── launcher ───────────────────────────────────────────────────
fn render_launcher(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        View{width: Fill height: Fit flow: Right spacing: 12
            tile_news_list := ButtonFlat{width: Fill height: 96 on_click: || nav.push("news_list")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "新闻简报" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_research_list := ButtonFlat{width: Fill height: 96 on_click: || nav.push("research_list")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "研究卡" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_kline := ButtonFlat{width: Fill height: 96 on_click: || nav.push("kline")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "行情看盘" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
        }
        View{width: Fill height: Fit flow: Right spacing: 12
            tile_news_detail := ButtonFlat{width: Fill height: 96 on_click: || nav.push("news_detail")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "新闻详情" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_research_detail := ButtonFlat{width: Fill height: 96 on_click: || nav.push("research_detail")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "研究详情" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_favorites := ButtonFlat{width: Fill height: 96 on_click: || nav.push("favorites")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "收藏" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
        }
        View{width: Fill height: Fit flow: Right spacing: 12
            tile_settings := ButtonFlat{width: Fill height: 96 on_click: || nav.push("settings")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "设置" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_event_stream := ButtonFlat{width: Fill height: 96 on_click: || nav.push("event_stream")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "事件流" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
            tile_disclaimer := ButtonFlat{width: Fill height: 96 on_click: || nav.push("disclaimer")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "免责声明" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
        }
        View{width: Fill height: Fit flow: Down spacing: 6 padding: 16
            Label{text: "备用槽" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            tile_datasource_status := ButtonFlat{width: Fill height: 96 on_click: || nav.push("datasource_status")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
                draw_text +: {color: colors.ink}
                Label{text: "数据源状态页" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            }
        }
    }
}

// ── 10 splash-inline screens (.card L0 bridge deferred) ─────────
// Each render_X returns a screen body; render_screen_placeholder dispatches
// by nav.current. Stub data only — host.X wires (news.refresh /
// research.list / quote.candles) plug in once octoscript#56 lands.
// splash has no `else if`; sequential `if` + `return` chains.

fn render_screen_placeholder(){
    if nav.current == "news_list"         { render_news_list()         return }
    if nav.current == "news_detail"       { render_news_detail()       return }
    if nav.current == "research_list"     { render_research_list()     return }
    if nav.current == "research_detail"   { render_research_detail()   return }
    if nav.current == "kline"             { render_kline()             return }
    if nav.current == "favorites"         { render_favorites()         return }
    if nav.current == "settings"          { render_settings()          return }
    if nav.current == "event_stream"      { render_event_stream()      return }
    if nav.current == "datasource_status" { render_datasource_status() return }
    if nav.current == "disclaimer"        { render_disclaimer()        return }
    View{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: nav.current draw_text.color: colors.ink draw_text.text_style.font_size: 18}
        Label{text: "(splash-inline stub; .card L0 not bridged yet)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
    }
}

// ── news list (P0 host wired + P2 ScrollYView) ─────────────────
fn render_news_list(){
    if loaded_news_list == false {
        loaded_news_list = true
        let r = host_news_refresh()
        if r.ok { data_news_list = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: "新闻简报" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_news_list.len() == 0 {
            Label{text: "暂无内容 — 等待 host.news.refresh 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
        }
        if data_news_list.len() > 0 {
            Label{text: "共 " + data_news_list.len() + " 条" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
            for i in data_news_list.len() {
                View{width: Fill height: Fit flow: Down spacing: 4 padding: 12
                    draw_bg.color: colors.bg_elevated border_radius: 8.0
                    Label{text: data_news_list[i].title draw_text.color: colors.ink draw_text.text_style.font_size: 14}
                    Label{text: data_news_list[i].source + " · " + data_news_list[i].ts draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
                }
            }
            btn_news_detail := ButtonFlat{text: "查看详情 →" height: 36 on_click: || nav.push("news_detail")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 8.0 border_size: 1.0}
                draw_text +: {color: colors.accent}}
        }
    }
}

// ── news detail (P0 host wired) ────────────────────────────────
fn render_news_detail(){
    if loaded_news_detail == false {
        loaded_news_detail = true
        let r = host_news_read("latest")
        if r.ok { data_news_detail = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "新闻详情" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_news_detail.title == nil {
            Label{text: "等待 host.news.read 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
        }
        if data_news_detail.title != nil {
            View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
                draw_bg.color: colors.bg_elevated border_radius: 8.0
                Label{text: data_news_detail.title draw_text.color: colors.ink draw_text.text_style.font_size: 16}
                Label{text: data_news_detail.source + " · " + data_news_detail.ts draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
                Label{text: data_news_detail.summary draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            }
        }
    }
}

// ── research list (P0 host wired + P2 ScrollYView) ─────────────
fn render_research_list(){
    if loaded_research_list == false {
        loaded_research_list = true
        let r = host_research_list()
        if r.ok { data_research_list = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: "研究卡" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_research_list.len() == 0 {
            Label{text: "暂无内容 — 等待 host.research.list 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
        }
        if data_research_list.len() > 0 {
            Label{text: "共 " + data_research_list.len() + " 类" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
            for i in data_research_list.len() {
                View{width: Fill height: Fit flow: Right spacing: 8 padding: 12
                    draw_bg.color: colors.bg_elevated border_radius: 8.0
                    Label{text: data_research_list[i].category draw_text.color: colors.ink draw_text.text_style.font_size: 14 width: Fill}
                    Label{text: data_research_list[i].count + " 篇" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
                }
            }
            btn_research_detail := ButtonFlat{text: "查看详情 →" height: 36 on_click: || nav.push("research_detail")
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 8.0 border_size: 1.0}
                draw_text +: {color: colors.accent}}
        }
    }
}

// ── research detail (P0 host wired) ────────────────────────────
fn render_research_detail(){
    if loaded_research_detail == false {
        loaded_research_detail = true
        let r = host_research_read("latest")
        if r.ok { data_research_detail = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "研究卡详情" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_research_detail.id == nil {
            Label{text: "等待 host.research.read 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
        }
        if data_research_detail.id != nil {
            View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
                draw_bg.color: colors.bg_elevated border_radius: 8.0
                Label{text: "事实层（蓝色实线）" draw_text.color: colors.accent draw_text.text_style.font_size: 14}
                Label{text: data_research_detail.body draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            }
        }
    }
}

// ── kline (P0 host wired + P1 chips := id) ─────────────────────
fn render_kline(){
    if loaded_kline == false {
        loaded_kline = true
        let r = host_quote_candles("sh000001", "1d")
        if r.ok { data_kline = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "行情看盘" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "symbol=" + data_kline.symbol + " period=" + data_kline.period + "  载入 " + data_kline.bars.len() + " 根" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
        View{width: Fill height: Fit flow: Right spacing: 8
            draw_bg.color: colors.bg_elevated border_radius: 8.0 padding: 8
            btn_kline_1d := ButtonFlat{text: "1d" height: 28 on_click: || nav.push("kline")
                draw_bg +: {color: colors.accent color_hover: colors.accent border_radius: 14.0}
                draw_text +: {color: #xffffffff color_hover: #xffffffff}}
            btn_kline_5d := ButtonFlat{text: "5d" height: 28
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 14.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
            btn_kline_1mo := ButtonFlat{text: "1mo" height: 28
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 14.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
        }
        if data_kline.bars.len() == 0 {
            View{width: Fill height: Fit flow: Down spacing: 4 padding: 12
                draw_bg.color: colors.bg_elevated border_radius: 8.0
                Label{text: "等待 host.quote.candles 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
            }
        }
        if data_kline.bars.len() > 0 {
            View{width: Fill height: Fit flow: Down spacing: 2 padding: 8
                draw_bg.color: colors.bg_elevated border_radius: 8.0
                for i in data_kline.bars.len() {
                    let candle_color = colors.green_up
                    if data_kline.bars[i].close < data_kline.bars[i].open { candle_color = colors.red_down }
                    Label{text: data_kline.bars[i].timestamp + "  O:" + data_kline.bars[i].open + "  H:" + data_kline.bars[i].high + "  L:" + data_kline.bars[i].low + "  C:" + data_kline.bars[i].close + "  V:" + data_kline.bars[i].volume draw_text.color: candle_color draw_text.text_style.font_size: 10}
                }
            }
        }
    }
}

// ── disclaimer (P0 host wired — no host.call, just init data) ─
fn render_disclaimer(){
    if loaded_disclaimer == false {
        loaded_disclaimer = true
        data_disclaimer = {license: "Apache-2.0", sources: "sina/tencent/hyperliquid/frankfurter/stooq"}
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "免责声明" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "本应用仅供学习参考，不构成任何投资建议。" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "数据来源：" + data_disclaimer.sources draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            Label{text: "开源协议：" + data_disclaimer.license draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        }
    }
}

// ── favorites (P0 host wired) ──────────────────────────────────
fn render_favorites(){
    if loaded_favorites == false {
        loaded_favorites = true
        let r = host_fav_list()
        if r.ok { data_favorites = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "收藏" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_favorites.len() == 0 {
            Label{text: "暂无收藏 — 在新闻/研究详情里点 ★" draw_text.color: colors.secondary draw_text.text_style.font_size: 14}
        }
        if data_favorites.len() > 0 {
            Label{text: "共 " + data_favorites.len() + " 条" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
            for i in data_favorites.len() {
                View{width: Fill height: Fit flow: Down spacing: 4 padding: 12
                    draw_bg.color: colors.bg_elevated border_radius: 8.0
                    Label{text: "★ " + data_favorites[i].view + ": " + data_favorites[i].key draw_text.color: colors.ink draw_text.text_style.font_size: 14}
                }
            }
        }
    }
}

// ── settings (P0 host wired) ───────────────────────────────────
fn render_settings(){
    if loaded_settings == false {
        loaded_settings = true
        let r = host_settings_load()
        if r.ok { data_settings = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "设置" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(host.settings.load 已接线; 调用 host.settings.save 写回)" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "主题: " + data_settings.theme + " (light/dark)" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "刷新频率: " + data_settings.stream_frequency + " ms" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "字体大小: " + data_settings.font_size + " (sm/md/lg)" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
        }
    }
}

// ── event_stream (P0 host wired + P2 ScrollYView) ─────────────
fn render_event_stream(){
    if loaded_event_stream == false {
        loaded_event_stream = true
        let r = host_stream_tick()
        if r.ok { data_event_stream = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: "事件流" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_event_stream.len() == 0 {
            Label{text: "等待 host.stream.tick 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        }
        if data_event_stream.len() > 0 {
            Label{text: "最近 " + data_event_stream.len() + " 条" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
            for i in data_event_stream.len() {
                View{width: Fill height: Fit flow: Down spacing: 2 padding: 6
                    draw_bg.color: colors.bg_elevated border_radius: 6.0
                    Label{text: data_event_stream[i].ts + "  " + data_event_stream[i].kind draw_text.color: colors.secondary draw_text.text_style.font_size: 10}
                    Label{text: data_event_stream[i].text draw_text.color: colors.ink draw_text.text_style.font_size: 12}
                }
            }
        }
    }
}

// ── datasource_status (P0 host wired + P2 ScrollYView) ─────────
fn render_datasource_status(){
    if loaded_datasource_status == false {
        loaded_datasource_status = true
        let r = host_datasource_status()
        if r.ok { data_datasource_status = r.data }
        ui.root.set_visible(false)
        ui.root.set_visible(true)
    }
    ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: "数据源状态" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        if data_datasource_status.len() == 0 {
            Label{text: "等待 host.datasource.status 返回..." draw_text.color: colors.secondary draw_text.text_style.font_size: 13}
        }
        if data_datasource_status.len() > 0 {
            Label{text: "共 " + data_datasource_status.len() + " 个数据源" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
            for i in data_datasource_status.len() {
                let status_color = colors.green_up
                if data_datasource_status[i].status == "WARN" { status_color = colors.red_down }
                if data_datasource_status[i].status == "ERR" { status_color = colors.red_down }
                View{width: Fill height: Fit flow: Right spacing: 8 padding: 8
                    draw_bg.color: colors.bg_elevated border_radius: 6.0
                    Label{text: "● " + data_datasource_status[i].name draw_text.color: status_color draw_text.text_style.font_size: 13 width: Fill}
                    Label{text: data_datasource_status[i].status draw_text.color: status_color draw_text.text_style.font_size: 12}
                    Label{text: data_datasource_status[i].latency_ms + "ms" draw_text.color: colors.secondary draw_text.text_style.font_size: 11}
                }
            }
        }
    }
}

// ── boot ───────────────────────────────────────────────────────
start_timeout(0.05, || nav.go_home())

// ── root ───────────────────────────────────────────────────────
root := SolidView{width: Fill height: Fill flow: Down spacing: 0 draw_bg.color: colors.bg
    on_render: || {
        render_header()
        if nav.is_home() == true { render_launcher() }
        render_screen_placeholder()
    }
}
