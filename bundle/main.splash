            GestureView{width: Fit height: Fit on_tap: |x, y| open_tab("news")
                RoundedView{width: 160 height: 130 flow: Down padding: Inset{top: 18 bottom: 14 left: 14 right: 14} spacing: 8 align: Align{x: 0.5 y: 0.5}
                    new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 14.0
                    Label{text: "📰" align: Align{x: 0.5} draw_text.color: #xf2f4f8 draw_text.text_style +: {font_size: 28}}
                    Label{width: Fill text: "新闻简报" align: Align{x: 0.5} draw_text.color: #xf2f4f8 draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{width: Fill text: "Sina 要闻" align: Align{x: 0.5} draw_text.color: #x8e93a3 draw_text.text_style.font_size: 11}
                }
            }
            GestureView{width: Fit height: Fit on_tap: |x, y| pick_view("quotes")
                RoundedView{width: 160 height: 130 flow: Down padding: Inset{top: 18 bottom: 14 left: 14 right: 14} spacing: 8 align: Align{x: 0.5 y: 0.5}
                    new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 14.0
                    Label{text: "📈" align: Align{x: 0.5} draw_text.color: #xf2f4f8 draw_text.text_style +: {font_size: 28}}
                    Label{width: Fill text: "行情看盘" align: Align{x: 0.5} draw_text.color: #xf2f4f8 draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{width: Fill text: "A · 美 · 加 · 外" align: Align{x: 0.5} draw_text.color: #x8e93a3 draw_text.text_style.font_size: 11}
                }
            }
            GestureView{width: Fit height: Fit on_tap: |x, y| open_research()
                RoundedView{width: 160 height: 130 flow: Down padding: Inset{top: 18 bottom: 14 left: 14 right: 14} spacing: 8 align: Align{x: 0.5 y: 0.5}
