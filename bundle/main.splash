// Classify a fav by its id prefix; sample rows carry an extra "sample:".
fn fav_kind_of(raw){
    let id = "" + raw
    if starts(id, "sample:") { id = id.replace("sample:", "") }
    if starts(id, "news:") { return "news" }
    if starts(id, "a:") { return "a" }
    if starts(id, "us:") { return "us" }
    if starts(id, "crypto:") { return "crypto" }
    if starts(id, "fx:") { return "fx" }
    ""
}

fn fav_kind_label(kind){
    if kind == "news" { return "新闻" }
    if kind == "a" { return "A股" }
    if kind == "us" { return "美股" }
    if kind == "crypto" { return "加密" }
    if kind == "fx" { return "外汇" }
    "其他"
}

// Open a fav's detail in the main pane so it shares the existing detail view.
fn open_fav_detail(r){
    detail = r
    view = "main"
    refresh_pane()
    if ui.list != nil { ui.list.render() }
}

fn view_favs_grouped(){
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 6 right: 12 top: 14 bottom: 6}
            GhostButton{text: "‹ 返回" on_click: || pick_view("launcher")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "收藏" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
                Label{text: "按类型分组 · 共 " + ("" + favs.len()) + " 条" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
        }
        View{width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 14 right: 14 top: 8 bottom: 14}
            if favs.len() == 0 {
                View{width: Fill height: 220 align: Align{x: 0.5 y: 0.5}
                    Label{text: "暂无收藏 · 在行情或新闻页点详情中的「收藏」按钮添加" draw_text.color: secondary draw_text.text_style.font_size: 13}
                }
            }
            // Render one section per kind in fixed order; the empty ones are skipped.
            for kind_idx in 5 {
                let kind = if kind_idx == 0 { "news" }
                           else { if kind_idx == 1 { "a" }
                                  else { if kind_idx == 2 { "us" }
                                         else { if kind_idx == 3 { "crypto" } else { "fx" } } } }
                let group = []
                for f in favs { if fav_kind_of(f.id) == kind { group.push(f) } }
                if group.len() > 0 {
                    View{width: Fill height: Fit flow: Down spacing: 6
                        Label{width: Fill text: fav_kind_label(kind) + "  (" + ("" + group.len()) + ")"
                            draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 12}}
                        for r in group {
                            GestureView{width: Fill height: Fit on_tap: |x, y| open_fav_detail(r)
                                RoundedView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                                    new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 10.0
                                    Label{width: Fill text: r.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                    if r.kind == "quote" {
                                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                            Label{width: Fill text: sub_of(r) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                            Label{text: r.metric draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                            Label{text: pct_str(r.pct) draw_text.color: pct_color(r.pct) draw_text.text_style.font_size: 13}
                                        }
                                    }
                                    if r.kind == "news" {
                                        Label{width: Fill text: r.sub + "  " + hm(r.ts) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn view_settings(){
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 6 right: 12 top: 14 bottom: 6}
            GhostButton{text: "‹ 返回" on_click: || pick_view("launcher")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "设置" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
                Label{text: "主题 / 数据源 / 推送时段" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
        }
        View{width: Fill height: Fill flow: Down spacing: 18 padding: Inset{left: 18 right: 18 top: 14 bottom: 14}
            // Theme chips
            View{width: Fill height: Fit flow: Down spacing: 8
                Label{width: Fill text: "主题" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 12}}
                View{width: Fill height: Fit flow: Right spacing: 8
                    if settings.theme == "dark" { ChipOn{text: "深色" on_click: || set_theme("dark")} }
                    else { Chip{text: "深色" on_click: || set_theme("dark")} }
                    if settings.theme == "light" { ChipOn{text: "浅色" on_click: || set_theme("light")} }
                    else { Chip{text: "浅色" on_click: || set_theme("light")} }
                    if settings.theme == "auto" { ChipOn{text: "跟随时间" on_click: || set_theme("auto")} }
                    else { Chip{text: "跟随时间" on_click: || set_theme("auto")} }
                }
            }
            // Data source switches
            View{width: Fill height: Fit flow: Down spacing: 8
                Label{width: Fill text: "数据源" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 12}}
                View{width: Fill height: Fit flow: Down spacing: 6
                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                        View{width: Fill height: Fit flow: Down spacing: 2
                            Label{width: Fill text: "Sina 财经要闻" draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "feed.mix.sina.com.cn" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        }
                        if host_val("sina") == 1 { SwitchOn{text: "✓ 已启用" on_click: || toggle_setting("sina")} }
                        else { Switch{text: "○ 已禁用" on_click: || toggle_setting("sina")} }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                        View{width: Fill height: Fit flow: Down spacing: 2
                            Label{width: Fill text: "Tencent 行情" draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "qt.gtimg.cn" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        }
                        if host_val("tencent") == 1 { SwitchOn{text: "✓ 已启用" on_click: || toggle_setting("tencent")} }
                        else { Switch{text: "○ 已禁用" on_click: || toggle_setting("tencent")} }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                        View{width: Fill height: Fit flow: Down spacing: 2
                            Label{width: Fill text: "Hyperliquid 加密" draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "api.hyperliquid.xyz" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        }
                        if host_val("hyperliquid") == 1 { SwitchOn{text: "✓ 已启用" on_click: || toggle_setting("hyperliquid")} }
                        else { Switch{text: "○ 已禁用" on_click: || toggle_setting("hyperliquid")} }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                        View{width: Fill height: Fit flow: Down spacing: 2
                            Label{width: Fill text: "Frankfurter 外汇" draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{width: Fill text: "api.frankfurter.dev" draw_text.color: secondary draw_text.text_style.font_size: 11}
                        }
                        if host_val("frankfurter") == 1 { SwitchOn{text: "✓ 已启用" on_click: || toggle_setting("frankfurter")} }
                        else { Switch{text: "○ 已禁用" on_click: || toggle_setting("frankfurter")} }
                    }
                }
            }
            // Push schedule placeholder
            View{width: Fill height: Fit flow: Down spacing: 6
                Label{width: Fill text: "推送时段" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 12}}
                RoundedView{width: Fill height: Fit flow: Down padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                    new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 10.0
                    Label{width: Fill text: "未实现" draw_text.color: #x8e93a3 draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "后续版本提供" draw_text.color: secondary draw_text.text_style.font_size: 11}
                }
            }
            // Footer link
            View{width: Fill height: Fit flow: Right align: Align{x: 0.5} padding: Inset{top: 8}
                ButtonFlat{height: 32 padding: Inset{left: 12 right: 12}
                    draw_bg +: {border_radius: 16.0 color: #x00000000 color_hover: #xffffff14 color_down: #xffffff24 border_size: 0.0}
                    draw_text +: {color: #x5b9dff color_hover: #x8ab4ff color_down: #xa0c0ff text_style +: {font_size: 12}}
