// finance-brief main entry — single-file splash application (B-0 flat-let rewrite).
// Previous inlining kept `mod.lib.X.Y` dotted assignments that the splash L0
// dialect does not support (runtime: "property lib not found"). This rewrite
// adopts the flat pattern that worked in the initial commit ba85d44 (the
// 1059-line main.splash that ran without errors): top-level `let X = ...` for
// state + top-level `fn name(args) { ... }` whose bodies mutate the shared
// objects directly. lib/ directory is gone; this file is self-contained.
// History reference: ba85d44..4a30bb5 changed `let X = ...` into `mod.lib.X.Y`.

// ── colors ──────────────────────────────────────────────────────
let colors = {
    bg:          #xfafafa
    bg_elevated: #xffffff
    ink:         #x1c1c1e
    secondary:   #x8e8e93
    divider:     #xe5e5ea
    green_up:    #x34c759
    red_down:    #xff3b30
    accent:      #x007aff
    accent_h:    #x0a84ff
}

// ── nav ─────────────────────────────────────────────────────────
let nav = {
    current: "launcher"
    history: []
}

nav.push = fn(name){
    nav.history.push(nav.current)
    nav.current = name
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.back = fn(){
    if nav.history.len() == 0 { return }
    nav.current = nav.history.pop()
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.go_home = fn(){
    nav.history = []
    nav.current = "launcher"
    ui.root.set_visible(false)
    ui.root.set_visible(true)
}

nav.is_home = fn(){
    nav.current == "launcher"
}

// ── host ────────────────────────────────────────────────────────
// 15 host.call wrappers, one per capability listed in bundle/capabilities.toml.
// Defined as top-level `let host_X = fn(args) { ... }` so they sit alongside
// `colors` / `nav` without any module nesting or dynamic-key writes.

let host_news_refresh = fn(){
    host.call("news.refresh", {limit: 30})
}

let host_news_read = fn(id){
    host.call("news.read", {id: id})
}

let host_quote_snapshot = fn(tab){
    host.call("quote.snapshot", {tab: tab})
}

let host_quote_candles = fn(symbol, period){
    host.call("quote.candles", {symbol: symbol, period: period})
}

let host_research_list = fn(){
    host.call("research.list", {})
}

let host_research_read = fn(id){
    host.call("research.read", {id: id})
}

let host_stream_subscribe = fn(syms, ms){
    host.call("stream.subscribe", {symbols: syms, freq_ms: ms})
}

let host_stream_unsubscribe = fn(syms){
    host.call("stream.unsubscribe", {symbols: syms})
}

let host_stream_freq_set = fn(ms){
    host.call("stream.frequency.set", {freq_ms: ms})
}

let host_stream_tick = fn(){
    host.call("stream.tick", {limit: 30})
}

let host_datasource_status = fn(){
    host.call("datasource.status", {})
}

let host_fav_list = fn(){
    host.call("fav.list", {})
}

let host_fav_toggle = fn(id){
    host.call("fav.toggle", {id: id})
}

let host_settings_load = fn(){
    host.call("settings.load", {})
}

let host_settings_save = fn(v){
    host.call("settings.save", {value: v})
}

// ── launcher + header ───────────────────────────────────────────
// All `mod.lib.colors.X` → `colors.X`; `mod.lib.nav.X()` → `nav.X()`.
// No `use` statements (`use` is a reserved word in this splash dialect).

// ── header ─────────────────────────────────────────────────────
fn render_header(){
    View{width: Fill height: Fit flow: Right spacing: 8 padding: 16 align: Align{y: 0.5}
        if nav.is_home() == false {
            ButtonFlat{text: "← 返回" height: 36 on_click: || nav.back()
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 18.0 border_size: 1.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
        }
        Label{width: Fill text: "财经简报"
            draw_text.color: colors.ink
            draw_text.text_style.font_size: 22}
    }
}

// ── launcher tile ──────────────────────────────────────────────
fn render_tile(label, screen_name){
    ButtonFlat{width: Fill height: 96 on_click: || nav.push(screen_name)
        draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
        draw_text +: {color: colors.ink}
        Label{text: label draw_text.color: colors.ink draw_text.text_style.font_size: 16}
    }
}

// ── launcher ───────────────────────────────────────────────────
fn render_launcher(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        View{width: Fill height: Fit flow: Right spacing: 12
            render_tile("新闻简报", "news_list")
            render_tile("研究卡",   "research_list")
            render_tile("行情看盘", "kline")
        }
        View{width: Fill height: Fit flow: Right spacing: 12
            render_tile("新闻详情", "news_detail")
            render_tile("研究详情", "research_detail")
            render_tile("收藏",     "favorites")
        }
        View{width: Fill height: Fit flow: Right spacing: 12
            render_tile("设置",     "settings")
            render_tile("事件流",   "event_stream")
            render_tile("免责声明", "disclaimer")
        }
        View{width: Fill height: Fit flow: Down spacing: 6 padding: 16
            Label{text: "备用槽" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            render_tile("数据源状态页", "datasource_status")
        }
    }
}

// ── 6 splash-inline screens (.card L0 bridge deferred) ──────────
// Each render_X returns a screen body; render_screen_placeholder dispatches
// by nav.current. Stub data only — host.X wires (news.refresh /
// research.list / quote.candles) plug in once octoscript#56 lands.
// splash has no `else if`; sequential `if` + `return` chains.

fn render_screen_placeholder(){
    if nav.current == "news_list"       { render_news_list()      return }
    if nav.current == "news_detail"     { render_news_detail()    return }
    if nav.current == "research_list"   { render_research_list()  return }
    if nav.current == "research_detail" { render_research_detail() return }
    if nav.current == "kline"           { render_kline()          return }
    if nav.current == "disclaimer"      { render_disclaimer()     return }
    View{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: nav.current draw_text.color: colors.ink draw_text.text_style.font_size: 18}
        Label{text: "(splash-inline stub; .card L0 not bridged yet)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
    }
}

// ── news list (splash stub) ────────────────────────────────────
fn render_news_list(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "新闻简报" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(splash stub; .card not bridged — host.news.refresh 接入后此处显示 30 条)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "• 新浪财经头条  14:32" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "• 美联储议息会议纪要公布" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "• 央行公开市场净投放 1000 亿" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
        }
        ButtonFlat{text: "查看详情 →" on_click: || nav.push("news_detail")
            draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 8.0 border_size: 1.0}
            draw_text +: {color: colors.accent}}
    }
}

// ── news detail (splash stub) ──────────────────────────────────
fn render_news_detail(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "新闻详情" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(splash stub; .card not bridged)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "美联储议息会议纪要公布" draw_text.color: colors.ink draw_text.text_style.font_size: 16}
            Label{text: "14:32 · 新浪财经" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            Label{text: "本次会议与会者就通胀路径展开讨论，多数认为..." draw_text.color: colors.ink draw_text.text_style.font_size: 14}
        }
    }
}

// ── research list (splash stub) ────────────────────────────────
fn render_research_list(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "研究卡" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(splash stub; .card not bridged — host.research.list 接入后此处显示 5 类)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "宏观经济" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "行业分析" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "公司研究" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "市场策略" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "量化研究" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
        }
        ButtonFlat{text: "查看详情 →" on_click: || nav.push("research_detail")
            draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 8.0 border_size: 1.0}
            draw_text +: {color: colors.accent}}
    }
}

// ── research detail (splash stub) ──────────────────────────────
fn render_research_detail(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "研究卡详情" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(splash stub; .card not bridged — MVP 只做事实层)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "事实层（蓝色实线）" draw_text.color: colors.accent draw_text.text_style.font_size: 14}
            Label{text: "GDP 同比 +5.2% / CPI 同比 +0.8%" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
        }
    }
}

// ── kline (splash stub with period chips + price text) ────────
fn render_kline(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "行情看盘" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        Label{text: "(splash stub; .card not bridged — host.quote.candles 接入后此处显示 K 线)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            draw_bg.color: colors.bg_elevated border_radius: 8.0 padding: 8
            ButtonFlat{text: "1d" height: 28 on_click: || nav.push("kline")
                draw_bg +: {color: colors.accent color_hover: colors.accent_h border_radius: 14.0}
                draw_text +: {color: #xffffffff color_hover: #xffffffff}}
            ButtonFlat{text: "5d" height: 28
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 14.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
            ButtonFlat{text: "1mo" height: 28
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 14.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
        }
        View{width: Fill height: Fit flow: Down spacing: 4 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "上证指数 (000001) · 3,245.18" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "+18.42 (+0.57%)  vol 2.4B" draw_text.color: colors.green_up draw_text.text_style.font_size: 14}
            Label{text: "open 3,228.00  high 3,251.30  low 3,219.40  close 3,245.18" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            Label{text: "(K 线 widget 占位 — quote.candles 接入后渲染 60+ 根蜡烛)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        }
    }
}

// ── disclaimer (splash inline) ─────────────────────────────────
fn render_disclaimer(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "免责声明" draw_text.color: colors.ink draw_text.text_style.font_size: 20}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: 12
            draw_bg.color: colors.bg_elevated border_radius: 8.0
            Label{text: "本应用仅供学习参考，不构成任何投资建议。" draw_text.color: colors.ink draw_text.text_style.font_size: 14}
            Label{text: "数据来源：新浪财经 / 腾讯财经 / Hyperliquid / Frankfurter ECB / Stooq" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            Label{text: "开源协议：Apache-2.0" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
        }
    }
}

// ── boot ───────────────────────────────────────────────────────
start_timeout(0.05, || nav.go_home())

// ── root ───────────────────────────────────────────────────────
root := SolidView{width: Fill height: Fill flow: Down spacing: 0 draw_bg.color: colors.bg
    on_render: || {
        render_header()
        if nav.is_home() == true { render_launcher() }
        render_screen_placeholder()
    }
}
}
