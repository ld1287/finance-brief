// finance-brief main entry — single-file splash application (B-0 flat-let rewrite).
// Previous inlining kept `mod.lib.X.Y` dotted assignments that the splash L0
// dialect does not support (runtime: "property lib not found"). This rewrite
// adopts the flat pattern that worked in the initial commit ba85d44 (the
// 1059-line main.splash that ran without errors): top-level `let X = ...` for
// state + top-level `fn name(args) { ... }` whose bodies mutate the shared
// objects directly. lib/ directory is gone; this file is self-contained.
// History reference: ba85d44..4a30bb5 changed `let X = ...` into `mod.lib.X.Y`.

// ── colors ──────────────────────────────────────────────────────
let colors = {
    bg:          #xfafafa
    bg_elevated: #xffffff
    ink:         #x1c1c1e
    secondary:   #x8e8e93
    divider:     #xe5e5ea
    green_up:    #x34c759
    red_down:    #xff3b30
    accent:      #x007aff
    accent_h:    #x0a84ff
}

// ── nav ─────────────────────────────────────────────────────────
let nav = {
    current: "launcher"
    history: []
}

nav.push = fn(name){
    nav.history.push(nav.current)
    nav.current = name
}

nav.back = fn(){
    if nav.history.len() == 0 { return }
    nav.current = nav.history.pop()
}

nav.go_home = fn(){
    nav.history = []
    nav.current = "launcher"
}

nav.is_home = fn(){
    nav.current == "launcher"
}

// ── host ────────────────────────────────────────────────────────
// 15 host.call wrappers, one per capability listed in bundle/capabilities.toml.
// Defined as top-level `let host_X = fn(args) { ... }` so they sit alongside
// `colors` / `nav` without any module nesting or dynamic-key writes.

let host_news_refresh = fn(){
    host.call("news.refresh", {limit: 30})
}

let host_news_read = fn(id){
    host.call("news.read", {id: id})
}

let host_quote_snapshot = fn(tab){
    host.call("quote.snapshot", {tab: tab})
}

let host_quote_candles = fn(symbol, period){
    host.call("quote.candles", {symbol: symbol, period: period})
}

let host_research_list = fn(){
    host.call("research.list", {})
}

let host_research_read = fn(id){
    host.call("research.read", {id: id})
}

let host_stream_subscribe = fn(syms, ms){
    host.call("stream.subscribe", {symbols: syms, freq_ms: ms})
}

let host_stream_unsubscribe = fn(syms){
    host.call("stream.unsubscribe", {symbols: syms})
}

let host_stream_freq_set = fn(ms){
    host.call("stream.frequency.set", {freq_ms: ms})
}

let host_stream_tick = fn(){
    host.call("stream.tick", {limit: 30})
}

let host_datasource_status = fn(){
    host.call("datasource.status", {})
}

let host_fav_list = fn(){
    host.call("fav.list", {})
}

let host_fav_toggle = fn(id){
    host.call("fav.toggle", {id: id})
}

let host_settings_load = fn(){
    host.call("settings.load", {})
}

let host_settings_save = fn(v){
    host.call("settings.save", {value: v})
}

// ── launcher + header ───────────────────────────────────────────
// All `mod.lib.colors.X` → `colors.X`; `mod.lib.nav.X()` → `nav.X()`.
// No `use` statements (`use` is a reserved word in this splash dialect).

// ── header ─────────────────────────────────────────────────────
fn render_header(){
    View{width: Fill height: Fit flow: Right spacing: 8 padding: 16 align: Align{y: 0.5}
        if nav.is_home() == false {
            ButtonFlat{text: "← 返回" height: 36 on_click: || nav.back()
                draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 18.0 border_size: 1.0}
                draw_text +: {color: colors.ink color_hover: colors.accent}}
        }
        Label{width: Fill text: "财经简报"
            draw_text.color: colors.ink
            draw_text.text_style.font_size: 22}
    }
}

// ── launcher tile ──────────────────────────────────────────────
fn render_tile(label, screen_name){
    ButtonFlat{width: Fill height: 96 on_click: || nav.push(screen_name)
        draw_bg +: {color: colors.bg_elevated color_hover: colors.divider border_radius: 12.0 border_size: 1.0}
        draw_text +: {color: colors.ink}
        Label{text: label draw_text.color: colors.ink draw_text.text_style.font_size: 16}
    }
}

// ── launcher ───────────────────────────────────────────────────
fn render_launcher(){
    View{width: Fill height: Fill flow: Down spacing: 12 padding: 16
        View{width: Fill height: Fit flow: Right spacing: 12
            render_tile("新闻简报", "news_list")
            render_tile("研究卡",   "research_list")
            render_tile("行情看盘", "quote_list")
        }
        View{width: Fill height: Fit flow: Right spacing: 12
            render_tile("收藏",     "favorites")
            render_tile("设置",     "settings")
            render_tile("事件流",   "event_stream")
        }
        View{width: Fill height: Fit flow: Down spacing: 6 padding: 16
            Label{text: "备用槽" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
            render_tile("数据源状态页", "datasource_status")
        }
    }
}

// ── screen placeholder (real screens are .card files loaded by host) ──
fn render_screen_placeholder(){
    View{width: Fill height: Fill flow: Down spacing: 8 padding: 16
        Label{text: nav.current draw_text.color: colors.ink draw_text.text_style.font_size: 18}
        Label{text: "(host loads the corresponding .card)" draw_text.color: colors.secondary draw_text.text_style.font_size: 12}
    }
}

// ── boot ───────────────────────────────────────────────────────
start_timeout(0.05, || nav.go_home())

// ── root ───────────────────────────────────────────────────────
SolidView{width: Fill height: Fill flow: Down spacing: 0 draw_bg.color: colors.bg
    on_render: || {
        render_header()
        if nav.is_home() == true { render_launcher() }
        render_screen_placeholder()
    }
}
