// C2: quotes_pane 独立 view（toolbar + 3 tab + K 线主体）。
fn view_quotes(){
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 12 right: 12 top: 16 bottom: 8}
            GhostButton{text: "‹ 主页" on_click: || pick_view("launcher")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "行情看盘" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
                Label{text: "实时 K 线（合成数据 MVP）" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
        }

        View{width: Fill height: 44 flow: Right spacing: 6 padding: Inset{left: 12 right: 12 top: 4 bottom: 8}
            if quote_pane_tab == "a" { ChipOn{text: "A股" on_click: || pick_quote_pane("a")} }
            if quote_pane_tab != "a" { Chip{text: "A股" on_click: || pick_quote_pane("a")} }
            if quote_pane_tab == "us" { ChipOn{text: "美股" on_click: || pick_quote_pane("us")} }
            if quote_pane_tab != "us" { Chip{text: "美股" on_click: || pick_quote_pane("us")} }
            if quote_pane_tab == "onchain" { ChipOn{text: "链上" on_click: || pick_quote_pane("onchain")} }
            if quote_pane_tab != "onchain" { Chip{text: "链上" on_click: || pick_quote_pane("onchain")} }
        }

        View{width: Fill height: Fill flow: Down spacing: 6 padding: Inset{left: 12 right: 12 bottom: 24}
            Label{text: "周期 · " + quote_pane_period draw_text.color: secondary draw_text.text_style.font_size: 12}
            View{width: Fill height: 32 flow: Right spacing: 4
                if quote_pane_period == "1m" { ChipOn{text: "1m" on_click: || switch_quote_pane_period("1m")} }
                if quote_pane_period != "1m" { Chip{text: "1m" on_click: || switch_quote_pane_period("1m")} }
                if quote_pane_period == "5m" { ChipOn{text: "5m" on_click: || switch_quote_pane_period("5m")} }
                if quote_pane_period != "5m" { Chip{text: "5m" on_click: || switch_quote_pane_period("5m")} }
                if quote_pane_period == "1d" { ChipOn{text: "1d" on_click: || switch_quote_pane_period("1d")} }
                if quote_pane_period != "1d" { Chip{text: "1d" on_click: || switch_quote_pane_period("1d")} }
            }
            CandlestickChart{
                width: Fill height: Fill
            }
        }
    }
}

