    }
}

fn view_research(){
    let lst = research_list()
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 6 right: 12 top: 14 bottom: 6}
            GhostButton{text: "‹ 返回" on_click: || pick_view("launcher")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "研究卡" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
                Label{text: "事实层 · 来自要闻 · 共 " + ("" + lst.len()) + " 张" draw_text.color: secondary draw_text.text_style.font_size: 11}
                Label{text: "AI 生成内容，仅供参考，不构成投资建议" draw_text.color: #xfca5a5 draw_text.text_style.font_size: 10}
            }
        }
        ScrollXView{width: Fill height: 48 flow: Right spacing: 8 padding: Inset{left: 12 right: 12 top: 4 bottom: 8}
            for f in research_filters {
                if f.id == research_filter { ChipOn{text: f.label on_click: || set_research_filter(f.id)} }
                else { Chip{text: f.label on_click: || set_research_filter(f.id)} }
            }
        }
        ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: Inset{left: 12 right: 12 bottom: 24}
            if lst.len() == 0 {
                View{width: Fill height: 220 align: Align{x: 0.5 y: 0.5}
                    Label{text: "暂无匹配的研究卡 · 要闻刷新后自动生成" draw_text.color: secondary draw_text.text_style.font_size: 13}
                }
            }
            for i in lst.len() {
                GestureView{width: Fill height: Fit on_tap: |x, y| open_research_detail(i)
                    RoundedView{width: Fill height: Fit flow: Right spacing: 10 padding: Inset{top: 10 bottom: 10 left: 10 right: 12}
                        new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 10.0
                        RoundedView{width: 4 height: 44 show_bg: true draw_bg.color: research_color(lst[i].cat) draw_bg.border_radius: 2.0}
                        View{width: Fill height: Fit flow: Down spacing: 4
                            Label{text: research_label(lst[i].cat) draw_text.color: research_color(lst[i].cat) draw_text.text_style: theme.font_bold{font_size: 11}}
                            Label{width: Fill text: lst[i].row.title draw_text.color: ink draw_text.text_style.font_size: 15}
                            Label{width: Fill text: source_line(lst[i].row) draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                    }
                }
            }
        }
    }
}

// I-5: three stacked sections. Only the fact layer is real in Phase 1.
fn view_research_detail(){
    let e = research_cur()
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 6 right: 12 top: 14 bottom: 6}
            GhostButton{text: "‹ 研究卡" on_click: || pick_view("research")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "研究卡详情" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
                if e != nil { Label{text: research_label(e.cat) draw_text.color: research_color(e.cat) draw_text.text_style.font_size: 11} }
            }
        }
        ScrollYView{width: Fill height: Fill flow: Down spacing: 12 padding: Inset{left: 12 right: 12 top: 4 bottom: 24}
            RoundedView{width: Fill height: Fit padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                new_batch: true show_bg: true draw_bg.color: #x3b1518 draw_bg.border_radius: 10.0
                Label{width: Fill text: "⚠ AI 生成内容，仅供参考，不构成投资建议" draw_text.color: #xfca5a5 draw_text.text_style: theme.font_bold{font_size: 14}}
            }
            if e == nil {
                View{width: Fill height: 220 align: Align{x: 0.5 y: 0.5}
                    Label{text: "研究卡已更新，请返回列表重新选择" draw_text.color: secondary draw_text.text_style.font_size: 13}
                }
            }
            if e != nil {
                // Fact layer
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    new_batch: true show_bg: true draw_bg.color: #x14223d draw_bg.border_radius: 12.0
                    draw_bg.border_size: 1.5 draw_bg.border_color: #x3b82f6
                    Label{text: "事实" draw_text.color: #x3b82f6 draw_text.text_style: theme.font_bold{font_size: 12}}
                    Label{width: Fill text: e.row.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: source_line(e.row) draw_text.color: secondary draw_text.text_style.font_size: 12}
                    if e.row.body != "" {
                        Label{width: Fill text: e.row.body draw_text.color: #xd7dbe6 draw_text.text_style.font_size: 14}
                    }
                    if e.row.body == "" {
                        Label{width: Fill text: "（无摘要）" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                    if clean_url(e.row.url) != "" {
                        Label{width: Fill text: clean_url(e.row.url) draw_text.color: #x5b9dff draw_text.text_style.font_size: 12}
                    }
                }
                // Analysis layer (Phase 2)
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    new_batch: true show_bg: true draw_bg.color: #x221a3a draw_bg.border_radius: 12.0
                    Label{text: "分析 · AI 生成" draw_text.color: #x8b5cf6 draw_text.text_style: theme.font_bold{font_size: 12}}
                    Label{width: Fill text: "Phase 2：AI 解读与历史相似事件对比（未实现）" draw_text.color: #xa8a3c0 draw_text.text_style.font_size: 13}
                }
                // Action layer (Phase 2)
                RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                    new_batch: true show_bg: true draw_bg.color: #x1c1f26 draw_bg.border_radius: 12.0
                    Label{text: "建议" draw_text.color: #x6b7280 draw_text.text_style: theme.font_bold{font_size: 12}}
                    Label{width: Fill text: "Phase 2：仅供参考的逻辑推演，不构成任何交易指令（未实现）" draw_text.color: #x9ca3af draw_text.text_style.font_size: 13}
                }
                View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 4}
                    if is_fav(e.row.id) { BarButton{text: "⭐ 取消收藏" on_click: || toggle_research_fav(e.row)} }
                    else { BarButton{text: "⭐ 收藏" on_click: || toggle_research_fav(e.row)} }
                    ChipOff{text: "✓ 确认 (Phase 2)"}
                    ChipOff{text: "✗ 驳回 (Phase 2)"}
                }
            }
        }
    }
}

// ---------------------------------------------------------------- program

// Root: flow: Overlay so only one of the five panes is visible at a time.
SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #x0e1117

    launcher_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_launcher()
    }

    main_pane := View{visible: false width: Fill height: Fill flow: Down

        View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 12 right: 12 top: 16 bottom: 8}
            GhostButton{text: "‹ 主页" on_click: || pick_view("launcher")}
            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 8}
                Label{text: "财经简报" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
                Label{text: "要闻 · 行情(4 chip) · K线 · 收藏" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            BarButton{text: "刷新" on_click: || refresh()}
        }

        tabbar := ScrollXView{width: Fill height: 44 flow: Right spacing: 4 padding: Inset{left: 12 right: 12 top: 4 bottom: 8}
            on_render: || {
                if tab == "quotes" {
                    for c in quote_chips {
                        if c.id == quote_chip {
                            Chip{text: c.label on_click: || pick_quote(c.id)
                                draw_bg +: {color: #x2a3142 color_hover: #x323a4d color_down: #x3a4360}
                                draw_text +: {color: #xffffff}
                            }
                        }
                        if c.id != quote_chip {
                            Chip{text: c.label on_click: || pick_quote(c.id)}
                        }
                    }
                }
                for t in tabs {
                    if t.id == tab { TabButtonActive{text: t.label on_click: || pick(t.id)} }
                    else { TabButton{text: t.label on_click: || pick(t.id)} }
                }
            }
        }

        status := Label{width: Fill padding: Inset{left: 18 right: 18 bottom: 6} text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}

        list := ScrollYView{width: Fill height: Fill flow: Down spacing: 8 padding: Inset{left: 12 right: 12 bottom: 24}
            on_render: || {
                if detail != nil {
                    RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 14 bottom: 14 left: 14 right: 14}
                        new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 12.0
                        Label{width: Fill text: detail.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                        if detail.kind != "news" {
                            Label{width: Fill text: sub_of(detail) + "  " + hm(detail.ts) draw_text.color: secondary draw_text.text_style.font_size: 12}
                        }
                        if detail.kind == "quote" {
                            Label{width: Fill text: detail.metric + "   " + pct_str(detail.pct) draw_text.color: pct_color(detail.pct) draw_text.text_style: theme.font_bold{font_size: 30}}
                            View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{top: 10}
                                Label{text: "K 线 · " + k_period draw_text.color: secondary draw_text.text_style.font_size: 12}
                                View{width: Fill height: 32 flow: Right spacing: 4
                                    if k_period == "1m" { ChipOn{text: "1m" on_click: || switch_kperiod("1m")} }
                                    if k_period != "1m" { Chip{text: "1m" on_click: || switch_kperiod("1m")} }
                                    if k_period == "5m" { ChipOn{text: "5m" on_click: || switch_kperiod("5m")} }
                                    if k_period != "5m" { Chip{text: "5m" on_click: || switch_kperiod("5m")} }
                                    if k_period == "1d" { ChipOn{text: "1d" on_click: || switch_kperiod("1d")} }
                                    if k_period != "1d" { Chip{text: "1d" on_click: || switch_kperiod("1d")} }
                                }
                                k_chart := CandlestickChart{
                                    width: Fill height: 320
                                    candle_up_color: #xe64340 candle_down_color: #x2ecc71
                                    bg_color: #x0e1117 grid_color: #x2a2a3e
                                    candle_width_fraction: 0.7
                                }
                            }
                        }
                        if detail.body != "" {
                            Label{width: Fill text: detail.body draw_text.color: #xd7dbe6 draw_text.text_style.font_size: 14}
                        }
                        if detail.kind == "news" {
                            View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{top: 4}
                                Label{width: Fill text: source_line(detail) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                if clean_url(detail.url) != "" {
                                    Label{width: Fill text: clean_url(detail.url) draw_text.color: #x5b9dff draw_text.text_style.font_size: 12}
                                }
                            }
                        }
                        if detail.kind != "news" {
                            if clean_url(detail.url) != "" {
                                Label{width: Fill text: clean_url(detail.url) draw_text.color: #x5b9dff draw_text.text_style.font_size: 12}
                            }
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{top: 6}
                            GhostButton{text: "返回列表" on_click: || close_detail()}
                            BarButton{text: "收藏 / 取消" on_click: || toggle_fav(detail)}
                        }
                    }
                }
                if detail == nil {
                    if tab == "news" {
                        View{width: Fill height: Fit flow: Right spacing: 8 padding: Inset{bottom: 4}
                            for f in news_filters {
                                if f.id == news_filter { ChipOn{text: f.label on_click: || set_news_filter(f.id)} }
                                else { Chip{text: f.label on_click: || set_news_filter(f.id)} }
                            }
                        }
                    }
                    if rows.len() == 0 {
                        if tab == "news" && news_filter != "all" {
                            View{width: Fill height: 220 align: Align{x: 0.5 y: 0.5}
                                Label{text: "当前主题暂无匹配新闻" draw_text.color: secondary draw_text.text_style.font_size: 13}
                            }
                        }
                        else {
                            View{width: Fill height: 220 align: Align{x: 0.5 y: 0.5}
                                Label{text: "暂无内容 — 点右上角「刷新」抓取" draw_text.color: secondary draw_text.text_style.font_size: 13}
                            }
                        }
                    }
                    for i in rows.len() {
                        GestureView{width: Fill height: Fit on_tap: |x, y| open_detail(i)
                            RoundedView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 10 bottom: 10 left: 12 right: 12}
                                new_batch: true show_bg: true draw_bg.color: #x171c26 draw_bg.border_radius: 10.0
                                Label{width: Fill text: rows[i].title draw_text.color: ink draw_text.text_style.font_size: 15}
                                if rows[i].kind == "quote" {
                                    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                        Label{width: Fill text: sub_of(rows[i]) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                        Label{text: rows[i].metric draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                        Label{text: pct_str(rows[i].pct) draw_text.color: pct_color(rows[i].pct) draw_text.text_style.font_size: 13}
                                    }
                                }
                                if rows[i].kind == "news" {
                                    Label{width: Fill text: rows[i].sub + "  " + hm(rows[i].ts) draw_text.color: secondary draw_text.text_style.font_size: 12}
                                }
                            }
                        }
                    }
                }
            }
        }

        Label{width: Fill padding: Inset{left: 18 right: 18 bottom: 10} text: "数据来自公开免密接口 · 仅供演示，不构成投资建议" draw_text.color: secondary draw_text.text_style.font_size: 10}
    }

    favs_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_favs_grouped()
    }

    settings_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_settings()
    }

    quotes_pane := View{visible: false width: Fill height: Fill flow: Down
        on_render: || view_quotes()
    }

    about_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_about()
    }

    research_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_research()
    }

    research_detail_pane := View{width: Fill height: Fill flow: Down
        on_render: || view_research_detail()
    }
}