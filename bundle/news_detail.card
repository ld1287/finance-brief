# ledger finance-brief-news-detail@0.3.0
# level:   L0
# model:   news_detail

source story    sys.news_item(id: state.selected, fields: [id, title, author, points, comments, url])
source env.locale sys.locale()

state selected { shape: text, initial: "" }    # "" ⇒ 不渲染（list 路径已发；详情总从 list 跳转进）

event back         { selected: clear }
event read_story   { selected: set($value) }       # 占位;屏跳转由 host 拦截 chip value

copy hdr        { class: vocabulary, en: "新闻详情",      zh: "新闻详情" }
copy back_lbl   { class: vocabulary, en: "‹ 新闻简报",    zh: "‹ 新闻简报" }
copy lbl_pts    { class: vocabulary, en: "分数",          zh: "分数" }
copy lbl_cmts   { class: vocabulary, en: "评论",          zh: "评论" }
copy lbl_by     { class: vocabulary, en: "作者",          zh: "作者" }

view root  Surface(pad: .page) { detail }

view detail  Col {
               Row(align: .center, gap: 10, on_tap: back) {
                 TextRow(text: copy.back_lbl)
               }
               TextCaption(text: copy.hdr)
               TextTitle(text: story.title, width: .fill)
               Row(gap: 8) {
                 TextCaption(value: story.points, suffix: copy.lbl_pts)
                 TextCaption(value: story.comments, suffix: copy.lbl_cmts)
                 TextCaption(text: copy.lbl_by)
                 TextCaption(text: story.author)
               }
               TextCaption(text: story.url)
               Chip(text: "打开原文 ↗", on_tap: read_story, value: story.url)
             }
