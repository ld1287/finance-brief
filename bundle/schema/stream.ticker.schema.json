{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance-brief/bundle/schema/stream.ticker.schema.json",
  "title": "StreamTicker",
  "description": "A single ticker / news-flash event in the stream frame.",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "description": "Unix epoch seconds when the event was emitted.",
      "minimum": 0
    },
    "category": {
      "type": "string",
      "description": "Top-level market bucket.",
      "enum": ["宏观", "A股", "港股", "美股", "加密", "外汇"]
    },
    "title": {
      "type": "string",
      "description": "Display title for the ticker card.",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "string",
      "description": "Publisher or origin (e.g. sina, mock, hyperliquid).",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "type": "string",
      "description": "Event kind discriminator.",
      "enum": ["news", "ticker", "alert"]
    },
    "symbols": {
      "type": "array",
      "description": "Optional related tickers (free-form).",
      "items": {"type": "string", "minLength": 1, "maxLength": 32},
      "maxItems": 16
    }
  },
  "required": ["ts", "category", "title", "source", "kind"],
  "additionalProperties": false
}
