{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finance-brief/bundle/schema/research.schema.json",
  "title": "ResearchNote",
  "description": "A long-form research note surfaced from the bundled sample library.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable note identifier used by research.read.",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "description": "Display title.",
      "minLength": 1,
      "maxLength": 256
    },
    "body": {
      "type": "string",
      "description": "Plain-text or markdown body of the note.",
      "minLength": 0,
      "maxLength": 65536
    },
    "tags": {
      "type": "array",
      "description": "Topic tags for filtering by research.list.",
      "items": {"type": "string", "minLength": 1, "maxLength": 32},
      "maxItems": 32
    },
    "author": {
      "type": "string",
      "description": "Author display name.",
      "minLength": 0,
      "maxLength": 64
    },
    "published_ts": {
      "type": "integer",
      "description": "Unix epoch seconds of publication.",
      "minimum": 0
    }
  },
  "required": ["id", "title", "body", "tags"],
  "additionalProperties": false
}
