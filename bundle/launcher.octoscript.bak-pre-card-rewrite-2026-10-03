// finance-brief Launcher — #1 of 12 screens (L0)
// Level:  L0 (declarative only, no derived arithmetic)
// Role:   6-tile grid + 1 backup slot, entry surface of the app
// Spec:   docs/R-4-l0-cards.md §3 row 1, MVP-TODO.md §5 screen #1
//
// Tiles (2 rows × 3 cols + 1 backup):
//   row 1: 新闻简报 / 研究卡 / 行情看盘
//   row 2: 收藏 / 设置 / 事件流
//   backup: 数据源状态页 (per Q-F: 5×8 fields latency / success rate)
//
// L0 constraints honored:
//   - no `let q = "{{state.q}}"` style trip_planner L2 binding
//   - no walrus operator (canonical fixtures use plain nested widgets)
//   - all text values are `{{state.x}}` placeholders, host resolves at realize
//
// State contract (host provides):
//   state.app_title          : text  — header copy
//   state.tiles              : list  — 6 entries, each {title, desc, view, icon}
//   state.backup_tile        : {title, desc, view}  — single entry for #12
//   state.status_line        : text  — footer copy (e.g. last sync)

View {
    width: Fill
    height: Fill
    flow: Down
    padding: 16
    gap: 1

    // ── header ──────────────────────────────────────────────────────────────
    Label {
        text: "{{state.app_title}}"
    }

    // ── row 1: 新闻简报 / 研究卡 / 行情看盘 ────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right
        gap: 1

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.0.title}}" }
            Label { text: "{{state.tiles.0.desc}}" }
            on_tap: || nav.push("{{state.tiles.0.view}}")
        }

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.1.title}}" }
            Label { text: "{{state.tiles.1.desc}}" }
            on_tap: || nav.push("{{state.tiles.1.view}}")
        }

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.2.title}}" }
            Label { text: "{{state.tiles.2.desc}}" }
            on_tap: || nav.push("{{state.tiles.2.view}}")
        }
    }

    // ── row 2: 收藏 / 设置 / 事件流 ─────────────────────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right
        gap: 1

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.3.title}}" }
            Label { text: "{{state.tiles.3.desc}}" }
            on_tap: || nav.push("{{state.tiles.3.view}}")
        }

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.4.title}}" }
            Label { text: "{{state.tiles.4.desc}}" }
            on_tap: || nav.push("{{state.tiles.4.view}}")
        }

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.tiles.5.title}}" }
            Label { text: "{{state.tiles.5.desc}}" }
            on_tap: || nav.push("{{state.tiles.5.view}}")
        }
    }

    // ── backup slot (#12 数据源状态页 / Agent 面板) ─────────────────────────
    View {
        width: Fill
        height: Fit
        flow: Right
        gap: 1

        View {
            width: Fit
            height: Fit
            Label { text: "{{state.backup_tile.title}}" }
            Label { text: "{{state.backup_tile.desc}}" }
            on_tap: || nav.push("{{state.backup_tile.view}}")
        }
    }

    // ── footer ───────────────────────────────────────────────────────────────
    Label {
        text: "{{state.status_line}}"
    }
}